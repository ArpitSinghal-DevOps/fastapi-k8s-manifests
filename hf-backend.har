:[\"libssh2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.522647+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libssh2 in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-3855\",\"title\":\"Security fix for libssh2 in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libssh2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.522622+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libssh2 in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2018-14550\",\"title\":\"Security fix for libpng in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpng\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521925+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpng in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2018-14048\",\"title\":\"Security fix for libpng in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpng\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521897+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpng in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-7317\",\"title\":\"Security fix for libpng in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpng\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521871+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpng in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-15165\",\"title\":\"Security fix for libpcap in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpcap\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521845+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpcap in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-15164\",\"title\":\"Security fix for libpcap in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpcap\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521819+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpcap in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-15163\",\"title\":\"Security fix for libpcap in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpcap\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521791+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpcap in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-15162\",\"title\":\"Security fix for libpcap in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpcap\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521764+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpcap in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-15161\",\"title\":\"Security fix for libpcap in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libpcap\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.521735+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libpcap in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-12290\",\"title\":\"Security fix for libidn2 in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libidn2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.519823+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libidn2 in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-18224\",\"title\":\"Security fix for libidn2 in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libidn2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.519795+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libidn2 in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2021-33560\",\"title\":\"Security fix for libgcrypt in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libgcrypt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.519533+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libgcrypt in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-13627\",\"title\":\"Security fix for libgcrypt in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libgcrypt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.519504+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libgcrypt in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-12904\",\"title\":\"Security fix for libgcrypt in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libgcrypt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.519476+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libgcrypt in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-20367\",\"title\":\"Security fix for libbsd in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"libbsd\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.517934+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for libbsd in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2017-1000232\",\"title\":\"Security fix for ldns in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"ldns\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.517469+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for ldns in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2017-1000231\",\"title\":\"Security fix for ldns in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"ldns\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.517437+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for ldns in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2016-4074\",\"title\":\"Security fix for jq in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"jq\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.516622+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for jq in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2019-20795\",\"title\":\"Security fix for iproute2 in Alpine Linux v3\",\"count\":1,\"active_affected_resources\":[\"iproute2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:24:01.516535+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for iproute2 in Alpine Linux v3.18\"},{\"cve_id\":\"CVE-2020-3810\",\"title\":\"Missing input validation in the ar/tar implementations of APT\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.780311+00:00\",\"source\":\"CVE Database\",\"description\":\"Missing input validation in the ar/tar implementations of APT before version 2.1.2 could result in denial of service when processing specially crafted deb files.\"},{\"cve_id\":\"CVE-2020-27350\",\"title\":\"APT had several integer overflows and underflows while parsing\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.780250+00:00\",\"source\":\"CVE Database\",\"description\":\"APT had several integer overflows and underflows while parsing .deb packages, aka GHSL-2020-168 GHSL-2020-169, in files apt-pkg/contrib/extracttar.cc, apt-pkg/deb/debfile.cc, and apt-pkg/contrib/arfile.cc. This issue affects: apt 1.2.32ubuntu0 versions prior to 1.2.32ubuntu0.2; 1.6.12ubuntu0 versions prior to 1.6.12ubuntu0.2; 2.0.2ubuntu0 versions prior to 2.0.2ubuntu0.2; 2.1.10ubuntu0 versions prior to 2.1.10ubuntu0.1;\"},{\"cve_id\":\"CVE-2019-3462\",\"title\":\"Incorrect sanitation of the 302 redirect field in HTTP transport method of apt versions 1\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.780139+00:00\",\"source\":\"CVE Database\",\"description\":\"Incorrect sanitation of the 302 redirect field in HTTP transport method of apt versions 1.4.8 and earlier can lead to content injection by a MITM attacker, potentially leading to remote code execution on the target machine.\"},{\"cve_id\":\"CVE-2018-0501\",\"title\":\"The mirror:// method implementation in Advanced Package Tool (APT) 1\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.780015+00:00\",\"source\":\"CVE Database\",\"description\":\"The mirror:// method implementation in Advanced Package Tool (APT) 1.6.x before 1.6.4 and 1.7.x before 1.7.0~alpha3 mishandles gpg signature verification for the InRelease file of a fallback mirror, aka mirrorfail.\"},{\"cve_id\":\"CVE-2016-1252\",\"title\":\"The apt package in Debian jessie\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779943+00:00\",\"source\":\"CVE Database\",\"description\":\"The apt package in Debian jessie before 1.0.9.8.4, in Debian unstable before 1.4~beta2, in Ubuntu 14.04 LTS before 1.0.1ubuntu2.17, in Ubuntu 16.04 LTS before 1.2.15ubuntu0.2, and in Ubuntu 16.10 before 1.3.2ubuntu0.1 allows man-in-the-middle attackers to bypass a repository-signing protection mechanism by leveraging improper error handling when validating InRelease file signatures.\"},{\"cve_id\":\"CVE-2014-7206\",\"title\":\"The changelog command in Apt\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779838+00:00\",\"source\":\"CVE Database\",\"description\":\"The changelog command in Apt before 1.0.9.2 allows local users to write to arbitrary files via a symlink attack on the changelog file.\"},{\"cve_id\":\"CVE-2014-6273\",\"title\":\"Buffer overflow in the HTTP transport code in apt-get in APT 1\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779741+00:00\",\"source\":\"CVE Database\",\"description\":\"Buffer overflow in the HTTP transport code in apt-get in APT 1.0.1 and earlier allows man-in-the-middle attackers to cause a denial of service (crash) or possibly execute arbitrary code via a crafted URL.\"},{\"cve_id\":\"CVE-2014-0490\",\"title\":\"The apt-get download command in APT\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779676+00:00\",\"source\":\"CVE Database\",\"description\":\"The apt-get download command in APT before 1.0.9 does not properly validate signatures for packages, which allows remote attackers to execute arbitrary code via a crafted package.\"},{\"cve_id\":\"CVE-2014-0489\",\"title\":\"APT\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779614+00:00\",\"source\":\"CVE Database\",\"description\":\"APT before 1.0.9, when the Acquire::GzipIndexes option is enabled, does not validate checksums, which allows remote attackers to execute arbitrary code via a crafted package.\"},{\"cve_id\":\"CVE-2014-0488\",\"title\":\"APT\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779554+00:00\",\"source\":\"CVE Database\",\"description\":\"APT before 1.0.9 does not \\\"invalidate repository data\\\" when moving from an unauthenticated to authenticated state, which allows remote attackers to have unspecified impact via crafted repository data.\"},{\"cve_id\":\"CVE-2014-0487\",\"title\":\"APT\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779488+00:00\",\"source\":\"CVE Database\",\"description\":\"APT before 1.0.9 does not verify downloaded files if they have been modified as indicated using the If-Modified-Since header, which has unspecified impact and attack vectors.\"},{\"cve_id\":\"CVE-2014-0478\",\"title\":\"APT\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779425+00:00\",\"source\":\"CVE Database\",\"description\":\"APT before 1.0.4 does not properly validate source packages, which allows man-in-the-middle attackers to download and install Trojan horse packages by removing the Release signature.\"},{\"cve_id\":\"CVE-2013-1051\",\"title\":\"apt 0\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779360+00:00\",\"source\":\"CVE Database\",\"description\":\"apt 0.8.16, 0.9.7, and possibly other versions does not properly handle InRelease files, which allows man-in-the-middle attackers to modify packages before installation via unknown vectors, possibly related to integrity checking and the use of third-party repositories.\"},{\"cve_id\":\"CVE-2012-3587\",\"title\":\"APT 0\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779281+00:00\",\"source\":\"CVE Database\",\"description\":\"APT 0.7.x before 0.7.25 and 0.8.x before 0.8.16, when using the apt-key net-update to import keyrings, relies on GnuPG argument order and does not check GPG subkeys, which might allow remote attackers to install Trojan horse packages via a man-in-the-middle (MITM) attack.\"},{\"cve_id\":\"CVE-2012-0961\",\"title\":\"Apt 0\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779200+00:00\",\"source\":\"CVE Database\",\"description\":\"Apt 0.8.16~exp5ubuntu13.x before 0.8.16~exp5ubuntu13.6, 0.8.16~exp12ubuntu10.x before 0.8.16~exp12ubuntu10.7, and 0.9.7.5ubuntu5.x before 0.9.7.5ubuntu5.2, as used in Ubuntu, uses world-readable permissions for /var/log/apt/term.log, which allows local users to obtain sensitive shell information by reading the log file.\"},{\"cve_id\":\"CVE-2012-0954\",\"title\":\"APT 0\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779104+00:00\",\"source\":\"CVE Database\",\"description\":\"APT 0.7.x before 0.7.25 and 0.8.x before 0.8.16, when using the apt-key net-update to import keyrings, relies on GnuPG argument order and does not check GPG subkeys, which might allow remote attackers to install altered packages via a man-in-the-middle (MITM) attack.  NOTE: this vulnerability exists because of an incomplete fix for CVE-2012-3587.\"},{\"cve_id\":\"CVE-2012-0214\",\"title\":\"The pkgAcqMetaClearSig::Failed method in apt-pkg/acquire-item\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.779003+00:00\",\"source\":\"CVE Database\",\"description\":\"The pkgAcqMetaClearSig::Failed method in apt-pkg/acquire-item.cc in Advanced Package Tool (APT) 0.8.11 through 0.8.15.10 and 0.8.16 before 0.8.16~exp13, when updating from repositories that use InRelease files, allows man-in-the-middle attackers to install arbitrary packages by preventing a user from downloading the new InRelease file, which leaves the original InRelease file active and makes it more difficult to detect that the Packages file is modified and unsigned.\"},{\"cve_id\":\"CVE-2011-3634\",\"title\":\"methods/https\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778883+00:00\",\"source\":\"CVE Database\",\"description\":\"methods/https.cc in apt before 0.8.11 accepts connections when the certificate host name fails validation and Verify-Host is enabled, which allows man-in-the-middle attackers to obtain repository credentials via unspecified vectors.\"},{\"cve_id\":\"CVE-2011-3374\",\"title\":\"It was found that apt-key in apt, all versions, do not correctly validate gpg keys with the master k...\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778809+00:00\",\"source\":\"CVE Database\",\"description\":\"It was found that apt-key in apt, all versions, do not correctly validate gpg keys with the master keyring, leading to a potential man-in-the-middle attack.\"},{\"cve_id\":\"CVE-2011-1829\",\"title\":\"APT\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778746+00:00\",\"source\":\"CVE Database\",\"description\":\"APT before 0.8.15.2 does not properly validate inline GPG signatures, which allows man-in-the-middle attackers to install modified packages via vectors involving lack of an initial clearsigned message.\"},{\"cve_id\":\"CVE-2009-1358\",\"title\":\"apt-get in apt\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778649+00:00\",\"source\":\"CVE Database\",\"description\":\"apt-get in apt before 0.7.21 does not check for the correct error code from gpgv, which causes apt to treat a repository as valid even when it has been signed with a key that has been revoked or expired, which might allow remote attackers to trick apt into installing malicious repositories.\"},{\"cve_id\":\"CVE-2009-1300\",\"title\":\"apt 0\",\"count\":1,\"active_affected_resources\":[\"apt\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778563+00:00\",\"source\":\"CVE Database\",\"description\":\"apt 0.7.20 does not check when the date command returns an \\\"invalid date\\\" error, which can prevent apt from loading security updates in time zones for which DST occurs at midnight.\"},{\"cve_id\":\"CVE-2017-12618\",\"title\":\"Apache Portable Runtime Utility (APR-util) 1\",\"count\":1,\"active_affected_resources\":[\"apr-util\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778412+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache Portable Runtime Utility (APR-util) 1.6.0 and prior fail to validate the integrity of SDBM database files used by apr_sdbm*() functions, resulting in a possible out of bound read access. A local user with write access to the database can make a program or process using these functions crash, and cause a denial of service.\"},{\"cve_id\":\"CVE-2016-6312\",\"title\":\"The mod_dontdothat component of the mod_dav_svn Apache module in Subversion as packaged in Red Hat E...\",\"count\":1,\"active_affected_resources\":[\"apr-util\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778321+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_dontdothat component of the mod_dav_svn Apache module in Subversion as packaged in Red Hat Enterprise Linux 5.11 does not properly detect recursion during entity expansion, which allows remote authenticated users with access to the webdav repository to cause a denial of service (memory consumption and httpd crash).  NOTE: Exists as a regression to CVE-2009-1955.\"},{\"cve_id\":\"CVE-2010-1623\",\"title\":\"Memory leak in the apr_brigade_split_line function in buckets/apr_brigade\",\"count\":1,\"active_affected_resources\":[\"apr-util\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778219+00:00\",\"source\":\"CVE Database\",\"description\":\"Memory leak in the apr_brigade_split_line function in buckets/apr_brigade.c in the Apache Portable Runtime Utility library (aka APR-util) before 1.3.10, as used in the mod_reqtimeout module in the Apache HTTP Server and other software, allows remote attackers to cause a denial of service (memory consumption) via unspecified vectors related to the destruction of an APR bucket.\"},{\"cve_id\":\"CVE-2009-2412\",\"title\":\"Multiple integer overflows in the Apache Portable Runtime (APR) library and the Apache Portable Util...\",\"count\":1,\"active_affected_resources\":[\"apr-util\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.778116+00:00\",\"source\":\"CVE Database\",\"description\":\"Multiple integer overflows in the Apache Portable Runtime (APR) library and the Apache Portable Utility library (aka APR-util) 0.9.x and 1.3.x allow remote attackers to cause a denial of service (application crash) or possibly execute arbitrary code via vectors that trigger crafted calls to the (1) allocator_alloc or (2) apr_palloc function in memory/unix/apr_pools.c in APR; or crafted calls to the (3) apr_rmm_malloc, (4) apr_rmm_calloc, or (5) apr_rmm_realloc function in misc/apr_rmm.c in APR-util; leading to buffer overflows.  NOTE: some of these details are obtained from third party information.\"},{\"cve_id\":\"CVE-2009-1956\",\"title\":\"Off-by-one error in the apr_brigade_vprintf function in Apache APR-util\",\"count\":1,\"active_affected_resources\":[\"apr-util\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.777915+00:00\",\"source\":\"CVE Database\",\"description\":\"Off-by-one error in the apr_brigade_vprintf function in Apache APR-util before 1.3.5 on big-endian platforms allows remote attackers to obtain sensitive information or cause a denial of service (application crash) via crafted input.\"},{\"cve_id\":\"CVE-2009-1955\",\"title\":\"The expat XML parser in the apr_xml_* interface in xml/apr_xml\",\"count\":1,\"active_affected_resources\":[\"apr-util\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.777839+00:00\",\"source\":\"CVE Database\",\"description\":\"The expat XML parser in the apr_xml_* interface in xml/apr_xml.c in Apache APR-util before 1.3.7, as used in the mod_dav and mod_dav_svn modules in the Apache HTTP Server, allows remote attackers to cause a denial of service (memory consumption) via a crafted XML document containing a large number of nested entity references, as demonstrated by a PROPFIND request, a similar issue to CVE-2003-1564.\"},{\"cve_id\":\"CVE-2009-0023\",\"title\":\"The apr_strmatch_precompile function in strmatch/apr_strmatch\",\"count\":1,\"active_affected_resources\":[\"apr-util\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.777737+00:00\",\"source\":\"CVE Database\",\"description\":\"The apr_strmatch_precompile function in strmatch/apr_strmatch.c in Apache APR-util before 1.3.5 allows remote attackers to cause a denial of service (daemon crash) via crafted input involving (1) a .htaccess file used with the Apache HTTP Server, (2) the SVNMasterURI directive in the mod_dav_svn module in the Apache HTTP Server, (3) the mod_apreq2 module for the Apache HTTP Server, or (4) an application that uses the libapreq2 library, which triggers a heap-based buffer underflow.\"},{\"cve_id\":\"CVE-2017-12613\",\"title\":\"When apr_time_exp*() or apr_os_exp_time*() functions are invoked with an invalid month field value i...\",\"count\":1,\"active_affected_resources\":[\"apr\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.777271+00:00\",\"source\":\"CVE Database\",\"description\":\"When apr_time_exp*() or apr_os_exp_time*() functions are invoked with an invalid month field value in Apache Portable Runtime APR 1.6.2 and prior, out of bounds memory may be accessed in converting this value to an apr_time_exp_t value, potentially revealing the contents of a different static heap value or resulting in program termination, and may represent an information disclosure or denial of service vulnerability to applications which call these APR functions with unvalidated external input.\"},{\"cve_id\":\"CVE-2012-0840\",\"title\":\"tables/apr_hash\",\"count\":1,\"active_affected_resources\":[\"apr\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.777154+00:00\",\"source\":\"CVE Database\",\"description\":\"tables/apr_hash.c in the Apache Portable Runtime (APR) library through 1.4.5 computes hash values without restricting the ability to trigger hash collisions predictably, which allows context-dependent attackers to cause a denial of service (CPU consumption) via crafted input to an application that maintains a hash table.\"},{\"cve_id\":\"CVE-2011-1928\",\"title\":\"The fnmatch implementation in apr_fnmatch\",\"count\":1,\"active_affected_resources\":[\"apr\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.777066+00:00\",\"source\":\"CVE Database\",\"description\":\"The fnmatch implementation in apr_fnmatch.c in the Apache Portable Runtime (APR) library 1.4.3 and 1.4.4, and the Apache HTTP Server 2.2.18, allows remote attackers to cause a denial of service (infinite loop) via a URI that does not match unspecified types of wildcard patterns, as demonstrated by attacks against mod_autoindex in httpd when a /*/WEB-INF/ configuration pattern is used.  NOTE: this issue exists because of an incorrect fix for CVE-2011-0419.\"},{\"cve_id\":\"CVE-2011-0419\",\"title\":\"Stack consumption vulnerability in the fnmatch implementation in apr_fnmatch\",\"count\":1,\"active_affected_resources\":[\"apr\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.776948+00:00\",\"source\":\"CVE Database\",\"description\":\"Stack consumption vulnerability in the fnmatch implementation in apr_fnmatch.c in the Apache Portable Runtime (APR) library before 1.4.3 and the Apache HTTP Server before 2.2.18, and in fnmatch.c in libc in NetBSD 5.1, OpenBSD 4.8, FreeBSD, Apple Mac OS X 10.6, Oracle Solaris 10, and Android, allows context-dependent attackers to cause a denial of service (CPU and memory consumption) via *? sequences in the first argument, as demonstrated by attacks against mod_autoindex in httpd.\"},{\"cve_id\":\"CVE-2009-2699\",\"title\":\"The Solaris pollset feature in the Event Port backend in poll/unix/port\",\"count\":1,\"active_affected_resources\":[\"apr\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.776831+00:00\",\"source\":\"CVE Database\",\"description\":\"The Solaris pollset feature in the Event Port backend in poll/unix/port.c in the Apache Portable Runtime (APR) library before 1.3.9, as used in the Apache HTTP Server before 2.2.14 and other products, does not properly handle errors, which allows remote attackers to cause a denial of service (daemon hang) via unspecified HTTP requests, related to the prefork and event MPMs.\"},{\"cve_id\":\"CVE-2025-66200\",\"title\":\"mod_userdir+suexec bypass via AllowOverride FileInfo vulnerability in Apache HTTP Server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.775169+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_userdir+suexec bypass via AllowOverride FileInfo vulnerability in Apache HTTP Server. Users with access to use the RequestHeader directive in htaccess can cause some CGI scripts to run under an unexpected userid.  This issue affects Apache HTTP Server: from 2.4.7 through 2.4.65.  Users are recommended to upgrade to version 2.4.66, which fixes the issue.\"},{\"cve_id\":\"CVE-2025-65082\",\"title\":\"Improper Neutralization of Escape, Meta, or Control Sequences vulnerability in Apache HTTP Server th...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.775068+00:00\",\"source\":\"CVE Database\",\"description\":\"Improper Neutralization of Escape, Meta, or Control Sequences vulnerability in Apache HTTP Server through environment variables set via the Apache configuration unexpectedly superseding variables calculated by the server for CGI programs.  This issue affects Apache HTTP Server from 2.4.0 through 2.4.65.  Users are recommended to upgrade to version 2.4.66 which fixes the issue.\"},{\"cve_id\":\"CVE-2025-59775\",\"title\":\"Server-Side Request Forgery (SSRF) vulnerability    in Apache HTTP Server on Windows   with AllowEnc...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.774962+00:00\",\"source\":\"CVE Database\",\"description\":\"Server-Side Request Forgery (SSRF) vulnerability    in Apache HTTP Server on Windows   with AllowEncodedSlashes On and MergeSlashes Off  allows to potentially leak NTLM  hashes to a malicious server via SSRF and malicious requests or content  Users are recommended to upgrade to version 2.4.66, which fixes the issue.\"},{\"cve_id\":\"CVE-2025-58098\",\"title\":\"Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.774868+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache HTTP Server 2.4.65 and earlier with Server Side Includes (SSI) enabled and mod_cgid (but not mod_cgi) passes the shell-escaped query string to #exec cmd=\\\"...\\\" directives.  This issue affects Apache HTTP Server before 2.4.66.  Users are recommended to upgrade to version 2.4.66, which fixes the issue.\"},{\"cve_id\":\"CVE-2025-55753\",\"title\":\"An integer overflow in the case of failed ACME certificate renewal leads, after a number of failures...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.774774+00:00\",\"source\":\"CVE Database\",\"description\":\"An integer overflow in the case of failed ACME certificate renewal leads, after a number of failures (~30 days in default configurations), to the backoff timer becoming 0. Attempts to renew the certificate then are repeated without delays until it succeeds.  This issue affects Apache HTTP Server: from 2.4.30 before 2.4.66.   Users are recommended to upgrade to version 2.4.66, which fixes the issue.\"},{\"cve_id\":\"CVE-2021-20325\",\"title\":\"Missing fixes for CVE-2021-40438 and CVE-2021-26691 in the versions of httpd, as shipped in Red Hat ...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.769261+00:00\",\"source\":\"CVE Database\",\"description\":\"Missing fixes for CVE-2021-40438 and CVE-2021-26691 in the versions of httpd, as shipped in Red Hat Enterprise Linux 8.5.0, causes a security regression compared to the versions shipped in Red Hat Enterprise Linux 8.4. A user who installs or updates to Red Hat Enterprise Linux 8.5.0 would be vulnerable to the mentioned CVEs, even if they were properly fixed in Red Hat Enterprise Linux 8.4. CVE-2021-20325 was assigned to that Red Hat specific security regression and it does not affect the upstream versions of httpd.\"},{\"cve_id\":\"CVE-2020-11985\",\"title\":\"IP address spoofing when proxying using mod_remoteip and mod_rewrite For configurations using proxyi...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.768561+00:00\",\"source\":\"CVE Database\",\"description\":\"IP address spoofing when proxying using mod_remoteip and mod_rewrite For configurations using proxying with mod_remoteip and certain mod_rewrite rules, an attacker could spoof their IP address for logging and PHP scripts. Note this issue was fixed in Apache HTTP Server 2.4.24 but was retrospectively allocated a low severity CVE in 2020.\"},{\"cve_id\":\"CVE-2019-17567\",\"title\":\"Apache HTTP Server versions 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.768297+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache HTTP Server versions 2.4.6 to 2.4.46 mod_proxy_wstunnel configured on an URL that is not necessarily Upgraded by the origin server was tunneling the whole connection regardless, thus allowing for subsequent requests on the same connection to pass through with no HTTP validation, authentication or authorization possibly configured.\"},{\"cve_id\":\"CVE-2017-9789\",\"title\":\"When under stress, closing many connections, the HTTP/2 handling code in Apache httpd 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.765909+00:00\",\"source\":\"CVE Database\",\"description\":\"When under stress, closing many connections, the HTTP/2 handling code in Apache httpd 2.4.26 would sometimes access memory after it has been freed, resulting in potentially erratic behaviour.\"},{\"cve_id\":\"CVE-2017-9788\",\"title\":\"In Apache httpd\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.765841+00:00\",\"source\":\"CVE Database\",\"description\":\"In Apache httpd before 2.2.34 and 2.4.x before 2.4.27, the value placeholder in [Proxy-]Authorization headers of type 'Digest' was not initialized or reset before or between successive key=value assignments by mod_auth_digest. Providing an initial key with no '=' assignment could reflect the stale value of uninitialized pool memory used by the prior request, leading to leakage of potentially confidential information, and a segfault in other cases resulting in denial of service.\"},{\"cve_id\":\"CVE-2017-12171\",\"title\":\"A regression was found in the Red Hat Enterprise Linux 6\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.765091+00:00\",\"source\":\"CVE Database\",\"description\":\"A regression was found in the Red Hat Enterprise Linux 6.9 version of httpd 2.2.15-60, causing comments in the \\\"Allow\\\" and \\\"Deny\\\" configuration lines to be parsed incorrectly. A web administrator could unintentionally allow any client to access a restricted HTTP resource.\"},{\"cve_id\":\"CVE-2016-8743\",\"title\":\"Apache HTTP Server, in all releases prior to 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.765004+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache HTTP Server, in all releases prior to 2.2.32 and 2.4.25, was liberal in the whitespace accepted from requests and sent in response lines and headers. Accepting these different behaviors represented a security concern when httpd participates in any chain of proxies or interacts with back-end application servers, either through mod_proxy or using conventional CGI mechanisms, and may result in request smuggling, response splitting and cache pollution.\"},{\"cve_id\":\"CVE-2016-8740\",\"title\":\"The mod_http2 module in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764890+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_http2 module in the Apache HTTP Server 2.4.17 through 2.4.23, when the Protocols configuration includes h2 or h2c, does not restrict request-header length, which allows remote attackers to cause a denial of service (memory consumption) via crafted CONTINUATION frames in an HTTP/2 request.\"},{\"cve_id\":\"CVE-2016-5387\",\"title\":\"The Apache HTTP Server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764803+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server through 2.4.23 follows RFC 3875 section 4.1.18 and therefore does not protect applications from the presence of untrusted client data in the HTTP_PROXY environment variable, which might allow remote attackers to redirect an application's outbound HTTP traffic to an arbitrary proxy server via a crafted Proxy header in an HTTP request, aka an \\\"httpoxy\\\" issue.  NOTE: the vendor states \\\"This mitigation has been assigned the identifier CVE-2016-5387\\\"; in other words, this is not a CVE ID for a vulnerability.\"},{\"cve_id\":\"CVE-2016-4979\",\"title\":\"The Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764680+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server 2.4.18 through 2.4.20, when mod_http2 and mod_ssl are enabled, does not properly recognize the \\\"SSLVerifyClient require\\\" directive for HTTP/2 request authorization, which allows remote attackers to bypass intended access restrictions by leveraging the ability to send multiple requests over a single connection and aborting a renegotiation.\"},{\"cve_id\":\"CVE-2016-4975\",\"title\":\"Possible CRLF injection allowing HTTP response splitting attacks for sites which use mod_userdir\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764582+00:00\",\"source\":\"CVE Database\",\"description\":\"Possible CRLF injection allowing HTTP response splitting attacks for sites which use mod_userdir. This issue was mitigated by changes made in 2.4.25 and 2.2.32 which prohibit CR or LF injection into the \\\"Location\\\" or other outbound header key or value. Fixed in Apache HTTP Server 2.4.25 (Affected 2.4.1-2.4.23). Fixed in Apache HTTP Server 2.2.32 (Affected 2.2.0-2.2.31).\"},{\"cve_id\":\"CVE-2016-2161\",\"title\":\"In Apache HTTP Server versions 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764459+00:00\",\"source\":\"CVE Database\",\"description\":\"In Apache HTTP Server versions 2.4.0 to 2.4.23, malicious input to mod_auth_digest can cause the server to crash, and each instance continues to crash even for subsequently valid requests.\"},{\"cve_id\":\"CVE-2016-1546\",\"title\":\"The Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764391+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server 2.4.17 and 2.4.18, when mod_http2 is enabled, does not limit the number of simultaneous stream workers for a single HTTP/2 connection, which allows remote attackers to cause a denial of service (stream-processing outage) via modified flow-control windows.\"},{\"cve_id\":\"CVE-2016-0736\",\"title\":\"In Apache HTTP Server versions 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764308+00:00\",\"source\":\"CVE Database\",\"description\":\"In Apache HTTP Server versions 2.4.0 to 2.4.23, mod_session_crypto was encrypting its data/cookie using the configured ciphers with possibly either CBC or ECB modes of operation (AES256-CBC by default), hence no selectable or builtin authenticated encryption. This made it vulnerable to padding oracle attacks, particularly with CBC.\"},{\"cve_id\":\"CVE-2015-3675\",\"title\":\"The default configuration of the Apache HTTP Server on Apple OS X\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764216+00:00\",\"source\":\"CVE Database\",\"description\":\"The default configuration of the Apache HTTP Server on Apple OS X before 10.10.4 does not enable the mod_hfs_apple module, which allows remote attackers to bypass HTTP authentication via a crafted URL.\"},{\"cve_id\":\"CVE-2015-3185\",\"title\":\"The ap_some_auth_required function in server/request\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.764095+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_some_auth_required function in server/request.c in the Apache HTTP Server 2.4.x before 2.4.14 does not consider that a Require directive may be associated with an authorization setting rather than an authentication setting, which allows remote attackers to bypass intended access restrictions in opportunistic circumstances by leveraging the presence of a module that relies on the 2.2 API behavior.\"},{\"cve_id\":\"CVE-2015-3183\",\"title\":\"The chunked transfer coding implementation in the Apache HTTP Server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763987+00:00\",\"source\":\"CVE Database\",\"description\":\"The chunked transfer coding implementation in the Apache HTTP Server before 2.4.14 does not properly parse chunk headers, which allows remote attackers to conduct HTTP request smuggling attacks via a crafted request, related to mishandling of large chunk-size values and invalid chunk-extension characters in modules/http/http_filters.c.\"},{\"cve_id\":\"CVE-2015-0253\",\"title\":\"The read_request_line function in server/protocol\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763895+00:00\",\"source\":\"CVE Database\",\"description\":\"The read_request_line function in server/protocol.c in the Apache HTTP Server 2.4.12 does not initialize the protocol structure member, which allows remote attackers to cause a denial of service (NULL pointer dereference and process crash) by sending a request that lacks a method to an installation that enables the INCLUDES filter and has an ErrorDocument 400 directive specifying a local URI.\"},{\"cve_id\":\"CVE-2015-0228\",\"title\":\"The lua_websocket_read function in lua_request\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763793+00:00\",\"source\":\"CVE Database\",\"description\":\"The lua_websocket_read function in lua_request.c in the mod_lua module in the Apache HTTP Server through 2.4.12 allows remote attackers to cause a denial of service (child-process crash) by sending a crafted WebSocket Ping frame after a Lua script has called the wsupgrade function.\"},{\"cve_id\":\"CVE-2014-8109\",\"title\":\"mod_lua\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763699+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_lua.c in the mod_lua module in the Apache HTTP Server 2.3.x and 2.4.x through 2.4.10 does not support an httpd configuration in which the same Lua authorization provider is used with different arguments within different contexts, which allows remote attackers to bypass intended access restrictions in opportunistic circumstances by leveraging multiple Require directives, as demonstrated by a configuration that specifies authorization for one group to access a certain directory, and authorization for a second group to access a second directory.\"},{\"cve_id\":\"CVE-2014-3583\",\"title\":\"The handle_headers function in mod_proxy_fcgi\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763572+00:00\",\"source\":\"CVE Database\",\"description\":\"The handle_headers function in mod_proxy_fcgi.c in the mod_proxy_fcgi module in the Apache HTTP Server 2.4.10 allows remote FastCGI servers to cause a denial of service (buffer over-read and daemon crash) via long response headers.\"},{\"cve_id\":\"CVE-2014-3581\",\"title\":\"The cache_merge_headers_out function in modules/cache/cache_util\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763496+00:00\",\"source\":\"CVE Database\",\"description\":\"The cache_merge_headers_out function in modules/cache/cache_util.c in the mod_cache module in the Apache HTTP Server before 2.4.11 allows remote attackers to cause a denial of service (NULL pointer dereference and application crash) via an empty HTTP Content-Type header.\"},{\"cve_id\":\"CVE-2014-3523\",\"title\":\"Memory leak in the winnt_accept function in server/mpm/winnt/child\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763415+00:00\",\"source\":\"CVE Database\",\"description\":\"Memory leak in the winnt_accept function in server/mpm/winnt/child.c in the WinNT MPM in the Apache HTTP Server 2.4.x before 2.4.10 on Windows, when the default AcceptFilter is enabled, allows remote attackers to cause a denial of service (memory consumption) via crafted requests.\"},{\"cve_id\":\"CVE-2014-0231\",\"title\":\"The mod_cgid module in the Apache HTTP Server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763332+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_cgid module in the Apache HTTP Server before 2.4.10 does not have a timeout mechanism, which allows remote attackers to cause a denial of service (process hang) via a request to a CGI script that does not read from its stdin file descriptor.\"},{\"cve_id\":\"CVE-2014-0226\",\"title\":\"Race condition in the mod_status module in the Apache HTTP Server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763253+00:00\",\"source\":\"CVE Database\",\"description\":\"Race condition in the mod_status module in the Apache HTTP Server before 2.4.10 allows remote attackers to cause a denial of service (heap-based buffer overflow), or possibly obtain sensitive credential information or execute arbitrary code, via a crafted request that triggers improper scoreboard handling within the status_handler function in modules/generators/mod_status.c and the lua_ap_scoreboard_worker function in modules/lua/lua_request.c.\"},{\"cve_id\":\"CVE-2014-0118\",\"title\":\"The deflate_in_filter function in mod_deflate\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763144+00:00\",\"source\":\"CVE Database\",\"description\":\"The deflate_in_filter function in mod_deflate.c in the mod_deflate module in the Apache HTTP Server before 2.4.10, when request body decompression is enabled, allows remote attackers to cause a denial of service (resource consumption) via crafted request data that decompresses to a much larger size.\"},{\"cve_id\":\"CVE-2014-0117\",\"title\":\"The mod_proxy module in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.763058+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_proxy module in the Apache HTTP Server 2.4.x before 2.4.10, when a reverse proxy is enabled, allows remote attackers to cause a denial of service (child-process crash) via a crafted HTTP Connection header.\"},{\"cve_id\":\"CVE-2014-0098\",\"title\":\"The log_cookie function in mod_log_config\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762981+00:00\",\"source\":\"CVE Database\",\"description\":\"The log_cookie function in mod_log_config.c in the mod_log_config module in the Apache HTTP Server before 2.4.8 allows remote attackers to cause a denial of service (segmentation fault and daemon crash) via a crafted cookie that is not properly handled during truncation.\"},{\"cve_id\":\"CVE-2013-6438\",\"title\":\"The dav_xml_get_cdata function in main/util\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762899+00:00\",\"source\":\"CVE Database\",\"description\":\"The dav_xml_get_cdata function in main/util.c in the mod_dav module in the Apache HTTP Server before 2.4.8 does not properly remove whitespace characters from CDATA sections, which allows remote attackers to cause a denial of service (daemon crash) via a crafted DAV WRITE request.\"},{\"cve_id\":\"CVE-2013-5704\",\"title\":\"The mod_headers module in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762816+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_headers module in the Apache HTTP Server 2.2.22 allows remote attackers to bypass \\\"RequestHeader unset\\\" directives by placing a header in the trailer portion of data sent with chunked transfer coding.  NOTE: the vendor states \\\"this is not a security issue in httpd as such.\\\"\"},{\"cve_id\":\"CVE-2013-4352\",\"title\":\"The cache_invalidate function in modules/cache/cache_storage\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762732+00:00\",\"source\":\"CVE Database\",\"description\":\"The cache_invalidate function in modules/cache/cache_storage.c in the mod_cache module in the Apache HTTP Server 2.4.6, when a caching forward proxy is enabled, allows remote HTTP servers to cause a denial of service (NULL pointer dereference and daemon crash) via vectors that trigger a missing hostname value.\"},{\"cve_id\":\"CVE-2013-2249\",\"title\":\"mod_session_dbd\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762624+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_session_dbd.c in the mod_session_dbd module in the Apache HTTP Server before 2.4.5 proceeds with save operations for a session without considering the dirty flag and the requirement for a new session ID, which has unspecified impact and remote attack vectors.\"},{\"cve_id\":\"CVE-2013-1896\",\"title\":\"mod_dav\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762542+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_dav.c in the Apache HTTP Server before 2.2.25 does not properly determine whether DAV is enabled for a URI, which allows remote attackers to cause a denial of service (segmentation fault) via a MERGE request in which the URI is configured for handling by the mod_dav_svn module, but a certain href attribute in XML data refers to a non-DAV URI.\"},{\"cve_id\":\"CVE-2013-1862\",\"title\":\"mod_rewrite\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762448+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_rewrite.c in the mod_rewrite module in the Apache HTTP Server 2.2.x before 2.2.25 writes data to a log file without sanitizing non-printable characters, which might allow remote attackers to execute arbitrary commands via an HTTP request containing an escape sequence for a terminal emulator.\"},{\"cve_id\":\"CVE-2013-1048\",\"title\":\"The Debian apache2ctl script in the apache2 package squeeze\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762362+00:00\",\"source\":\"CVE Database\",\"description\":\"The Debian apache2ctl script in the apache2 package squeeze before 2.2.16-6+squeeze11, wheezy before 2.2.22-13, and sid before 2.2.22-13 for the Apache HTTP Server on Debian GNU/Linux does not properly create the /var/lock/apache2 lock directory, which allows local users to gain privileges via an unspecified symlink attack.\"},{\"cve_id\":\"CVE-2012-4929\",\"title\":\"The TLS protocol 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762266+00:00\",\"source\":\"CVE Database\",\"description\":\"The TLS protocol 1.2 and earlier, as used in Mozilla Firefox, Google Chrome, Qt, and other products, can encrypt compressed data without properly obfuscating the length of the unencrypted data, which allows man-in-the-middle attackers to obtain plaintext HTTP headers by observing length differences during a series of guesses in which a string in an HTTP request potentially matches an unknown string in an HTTP header, aka a \\\"CRIME\\\" attack.\"},{\"cve_id\":\"CVE-2012-4558\",\"title\":\"Multiple cross-site scripting (XSS) vulnerabilities in the balancer_handler function in the manager ...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762113+00:00\",\"source\":\"CVE Database\",\"description\":\"Multiple cross-site scripting (XSS) vulnerabilities in the balancer_handler function in the manager interface in mod_proxy_balancer.c in the mod_proxy_balancer module in the Apache HTTP Server 2.2.x before 2.2.24-dev and 2.4.x before 2.4.4 allow remote attackers to inject arbitrary web script or HTML via a crafted string.\"},{\"cve_id\":\"CVE-2012-4557\",\"title\":\"The mod_proxy_ajp module in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.762012+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_proxy_ajp module in the Apache HTTP Server 2.2.12 through 2.2.21 places a worker node into an error state upon detection of a long request-processing time, which allows remote attackers to cause a denial of service (worker consumption) via an expensive request.\"},{\"cve_id\":\"CVE-2012-3502\",\"title\":\"The proxy functionality in (1) mod_proxy_ajp\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761931+00:00\",\"source\":\"CVE Database\",\"description\":\"The proxy functionality in (1) mod_proxy_ajp.c in the mod_proxy_ajp module and (2) mod_proxy_http.c in the mod_proxy_http module in the Apache HTTP Server 2.4.x before 2.4.3 does not properly determine the situations that require closing a back-end connection, which allows remote attackers to obtain sensitive information in opportunistic circumstances by reading a response that was intended for a different client.\"},{\"cve_id\":\"CVE-2012-3499\",\"title\":\"Multiple cross-site scripting (XSS) vulnerabilities in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761826+00:00\",\"source\":\"CVE Database\",\"description\":\"Multiple cross-site scripting (XSS) vulnerabilities in the Apache HTTP Server 2.2.x before 2.2.24-dev and 2.4.x before 2.4.4 allow remote attackers to inject arbitrary web script or HTML via vectors involving hostnames and URIs in the (1) mod_imagemap, (2) mod_info, (3) mod_ldap, (4) mod_proxy_ftp, and (5) mod_status modules.\"},{\"cve_id\":\"CVE-2012-2687\",\"title\":\"Multiple cross-site scripting (XSS) vulnerabilities in the make_variant_list function in mod_negotia...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761735+00:00\",\"source\":\"CVE Database\",\"description\":\"Multiple cross-site scripting (XSS) vulnerabilities in the make_variant_list function in mod_negotiation.c in the mod_negotiation module in the Apache HTTP Server 2.4.x before 2.4.3, when the MultiViews option is enabled, allow remote attackers to inject arbitrary web script or HTML via a crafted filename that is not properly handled during construction of a variant list.\"},{\"cve_id\":\"CVE-2012-0883\",\"title\":\"envvars (aka envvars-std) in the Apache HTTP Server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761637+00:00\",\"source\":\"CVE Database\",\"description\":\"envvars (aka envvars-std) in the Apache HTTP Server before 2.4.2 places a zero-length directory name in the LD_LIBRARY_PATH, which allows local users to gain privileges via a Trojan horse DSO in the current working directory during execution of apachectl.\"},{\"cve_id\":\"CVE-2012-0216\",\"title\":\"The default configuration of the apache2 package in Debian GNU/Linux squeeze\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761558+00:00\",\"source\":\"CVE Database\",\"description\":\"The default configuration of the apache2 package in Debian GNU/Linux squeeze before 2.2.16-6+squeeze7, wheezy before 2.2.22-4, and sid before 2.2.22-4, when mod_php or mod_rivet is used, provides example scripts under the doc/ URI, which might allow local users to conduct cross-site scripting (XSS) attacks, gain privileges, or obtain sensitive information via vectors involving localhost HTTP requests to the Apache HTTP Server.\"},{\"cve_id\":\"CVE-2012-0053\",\"title\":\"protocol\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761450+00:00\",\"source\":\"CVE Database\",\"description\":\"protocol.c in the Apache HTTP Server 2.2.x through 2.2.21 does not properly restrict header information during construction of Bad Request (aka 400) error documents, which allows remote attackers to obtain the values of HTTPOnly cookies via vectors involving a (1) long or (2) malformed header in conjunction with crafted web script.\"},{\"cve_id\":\"CVE-2012-0031\",\"title\":\"scoreboard\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761356+00:00\",\"source\":\"CVE Database\",\"description\":\"scoreboard.c in the Apache HTTP Server 2.2.21 and earlier might allow local users to cause a denial of service (daemon crash during shutdown) or possibly have unspecified other impact by modifying a certain type field within a scoreboard shared memory segment, leading to an invalid call to the free function.\"},{\"cve_id\":\"CVE-2012-0021\",\"title\":\"The log_cookie function in mod_log_config\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761268+00:00\",\"source\":\"CVE Database\",\"description\":\"The log_cookie function in mod_log_config.c in the mod_log_config module in the Apache HTTP Server 2.2.17 through 2.2.21, when a threaded MPM is used, does not properly handle a %{}C format string, which allows remote attackers to cause a denial of service (daemon crash) via a cookie that lacks both a name and a value.\"},{\"cve_id\":\"CVE-2011-4415\",\"title\":\"The ap_pregsub function in server/util\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761174+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_pregsub function in server/util.c in the Apache HTTP Server 2.0.x through 2.0.64 and 2.2.x through 2.2.21, when the mod_setenvif module is enabled, does not restrict the size of values of environment variables, which allows local users to cause a denial of service (memory consumption or NULL pointer dereference) via a .htaccess file with a crafted SetEnvIf directive, in conjunction with a crafted HTTP request header, related to (1) the \\\"len +=\\\" statement and (2) the apr_pcalloc function call, a different vulnerability than CVE-2011-3607.\"},{\"cve_id\":\"CVE-2011-4317\",\"title\":\"The mod_proxy module in the Apache HTTP Server 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.761046+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_proxy module in the Apache HTTP Server 1.3.x through 1.3.42, 2.0.x through 2.0.64, and 2.2.x through 2.2.21, when the Revision 1179239 patch is in place, does not properly interact with use of (1) RewriteRule and (2) ProxyPassMatch pattern matches for configuration of a reverse proxy, which allows remote attackers to send requests to intranet servers via a malformed URI containing an @ (at sign) character and a : (colon) character in invalid positions.  NOTE: this vulnerability exists because of an incomplete fix for CVE-2011-3368.\"},{\"cve_id\":\"CVE-2011-3639\",\"title\":\"The mod_proxy module in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760910+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_proxy module in the Apache HTTP Server 2.0.x through 2.0.64 and 2.2.x before 2.2.18, when the Revision 1179239 patch is in place, does not properly interact with use of (1) RewriteRule and (2) ProxyPassMatch pattern matches for configuration of a reverse proxy, which allows remote attackers to send requests to intranet servers by using the HTTP/0.9 protocol with a malformed URI containing an initial @ (at sign) character.  NOTE: this vulnerability exists because of an incomplete fix for CVE-2011-3368.\"},{\"cve_id\":\"CVE-2011-3607\",\"title\":\"Integer overflow in the ap_pregsub function in server/util\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760786+00:00\",\"source\":\"CVE Database\",\"description\":\"Integer overflow in the ap_pregsub function in server/util.c in the Apache HTTP Server 2.0.x through 2.0.64 and 2.2.x through 2.2.21, when the mod_setenvif module is enabled, allows local users to gain privileges via a .htaccess file with a crafted SetEnvIf directive, in conjunction with a crafted HTTP request header, leading to a heap-based buffer overflow.\"},{\"cve_id\":\"CVE-2011-3368\",\"title\":\"The mod_proxy module in the Apache HTTP Server 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760690+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_proxy module in the Apache HTTP Server 1.3.x through 1.3.42, 2.0.x through 2.0.64, and 2.2.x through 2.2.21 does not properly interact with use of (1) RewriteRule and (2) ProxyPassMatch pattern matches for configuration of a reverse proxy, which allows remote attackers to send requests to intranet servers via a malformed URI containing an initial @ (at sign) character.\"},{\"cve_id\":\"CVE-2011-3348\",\"title\":\"The mod_proxy_ajp module in the Apache HTTP Server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760588+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_proxy_ajp module in the Apache HTTP Server before 2.2.21, when used with mod_proxy_balancer in certain configurations, allows remote attackers to cause a denial of service (temporary \\\"error state\\\" in the backend server) via a malformed HTTP request.\"},{\"cve_id\":\"CVE-2011-3192\",\"title\":\"The byterange filter in the Apache HTTP Server 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760508+00:00\",\"source\":\"CVE Database\",\"description\":\"The byterange filter in the Apache HTTP Server 1.3.x, 2.0.x through 2.0.64, and 2.2.x through 2.2.19 allows remote attackers to cause a denial of service (memory and CPU consumption) via a Range header that expresses multiple overlapping ranges, as exploited in the wild in August 2011, a different vulnerability than CVE-2007-0086.\"},{\"cve_id\":\"CVE-2011-1176\",\"title\":\"The configuration merger in itk\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760409+00:00\",\"source\":\"CVE Database\",\"description\":\"The configuration merger in itk.c in the Steinar H. Gunderson mpm-itk Multi-Processing Module 2.2.11-01 and 2.2.11-02 for the Apache HTTP Server does not properly handle certain configuration sections that specify NiceValue but not AssignUserID, which might allow remote attackers to gain privileges by leveraging the root uid and root gid of an mpm-itk process.\"},{\"cve_id\":\"CVE-2010-2791\",\"title\":\"mod_proxy in httpd in Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760312+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_proxy in httpd in Apache HTTP Server 2.2.9, when running on Unix, does not close the backend connection if a timeout occurs when reading a response from a persistent connection, which allows remote attackers to obtain a potentially sensitive response intended for a different client in opportunistic circumstances via a normal HTTP request.  NOTE: this is the same issue as CVE-2010-2068, but for a different OS and set of affected versions.\"},{\"cve_id\":\"CVE-2010-2068\",\"title\":\"mod_proxy_http\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.760201+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_proxy_http.c in mod_proxy_http in the Apache HTTP Server 2.2.9 through 2.2.15, 2.3.4-alpha, and 2.3.5-alpha on Windows, NetWare, and OS/2, in certain configurations involving proxy worker pools, does not properly detect timeouts, which allows remote attackers to obtain a potentially sensitive response intended for a different client in opportunistic circumstances via a normal HTTP request.\"},{\"cve_id\":\"CVE-2010-1452\",\"title\":\"The (1) mod_cache and (2) mod_dav modules in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759937+00:00\",\"source\":\"CVE Database\",\"description\":\"The (1) mod_cache and (2) mod_dav modules in the Apache HTTP Server 2.2.x before 2.2.16 allow remote attackers to cause a denial of service (process crash) via a request that lacks a path.\"},{\"cve_id\":\"CVE-2010-0434\",\"title\":\"The ap_read_request function in server/protocol\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759863+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_read_request function in server/protocol.c in the Apache HTTP Server 2.2.x before 2.2.15, when a multithreaded MPM is used, does not properly handle headers in subrequests in certain circumstances involving a parent request that has a body, which might allow remote attackers to obtain sensitive information via a crafted request that triggers access to memory locations associated with an earlier request.\"},{\"cve_id\":\"CVE-2010-0425\",\"title\":\"modules/arch/win32/mod_isapi\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759760+00:00\",\"source\":\"CVE Database\",\"description\":\"modules/arch/win32/mod_isapi.c in mod_isapi in the Apache HTTP Server 2.0.37 through 2.0.63, 2.2.0 through 2.2.14, and 2.3.x before 2.3.7, when running on Windows, does not ensure that request processing is complete before calling isapi_unload for an ISAPI .dll module, which allows remote attackers to execute arbitrary code via unspecified vectors related to a crafted request, a reset packet, and \\\"orphaned callback pointers.\\\"\"},{\"cve_id\":\"CVE-2010-0408\",\"title\":\"The ap_proxy_ajp_request function in mod_proxy_ajp\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759648+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_proxy_ajp_request function in mod_proxy_ajp.c in mod_proxy_ajp in the Apache HTTP Server 2.2.x before 2.2.15 does not properly handle certain situations in which a client sends no request body, which allows remote attackers to cause a denial of service (backend server outage) via a crafted request, related to use of a 500 error code instead of the appropriate 400 error code.\"},{\"cve_id\":\"CVE-2009-3095\",\"title\":\"The mod_proxy_ftp module in the Apache HTTP Server allows remote attackers to bypass intended access...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759391+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_proxy_ftp module in the Apache HTTP Server allows remote attackers to bypass intended access restrictions and send arbitrary commands to an FTP server via vectors related to the embedding of these commands in the Authorization HTTP header, as demonstrated by a certain module in VulnDisco Pack Professional 8.11.\"},{\"cve_id\":\"CVE-2009-3094\",\"title\":\"The ap_proxy_ftp_handler function in modules/proxy/proxy_ftp\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759303+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_proxy_ftp_handler function in modules/proxy/proxy_ftp.c in the mod_proxy_ftp module in the Apache HTTP Server 2.0.63 and 2.2.13 allows remote FTP servers to cause a denial of service (NULL pointer dereference and child process crash) via a malformed reply to an EPSV command.\"},{\"cve_id\":\"CVE-2009-1891\",\"title\":\"The mod_deflate module in Apache httpd 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759217+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_deflate module in Apache httpd 2.2.11 and earlier compresses large files until completion even after the associated network connection is closed, which allows remote attackers to cause a denial of service (CPU consumption).\"},{\"cve_id\":\"CVE-2009-1890\",\"title\":\"The stream_reqbody_cl function in mod_proxy_http\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759140+00:00\",\"source\":\"CVE Database\",\"description\":\"The stream_reqbody_cl function in mod_proxy_http.c in the mod_proxy module in the Apache HTTP Server before 2.3.3, when a reverse proxy is configured, does not properly handle an amount of streamed data that exceeds the Content-Length value, which allows remote attackers to cause a denial of service (CPU consumption) via crafted requests.\"},{\"cve_id\":\"CVE-2009-1195\",\"title\":\"The Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.759044+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server 2.2.11 and earlier 2.2 versions does not properly handle Options=IncludesNOEXEC in the AllowOverride directive, which allows local users to gain privileges by configuring (1) Options Includes, (2) Options +Includes, or (3) Options +IncludesNOEXEC in a .htaccess file, and then inserting an exec element in a .shtml file.\"},{\"cve_id\":\"CVE-2009-1191\",\"title\":\"mod_proxy_ajp\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758946+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_proxy_ajp.c in the mod_proxy_ajp module in the Apache HTTP Server 2.2.11 allows remote attackers to obtain sensitive response data, intended for a client that sent an earlier POST request with no request body, via an HTTP request.\"},{\"cve_id\":\"CVE-2008-2939\",\"title\":\"Cross-site scripting (XSS) vulnerability in proxy_ftp\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758870+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in proxy_ftp.c in the mod_proxy_ftp module in Apache 2.0.63 and earlier, and mod_proxy_ftp.c in the mod_proxy_ftp module in Apache 2.2.9 and earlier 2.2 versions, allows remote attackers to inject arbitrary web script or HTML via a wildcard in the last directory component in the pathname in an FTP URI.\"},{\"cve_id\":\"CVE-2008-2364\",\"title\":\"The ap_proxy_http_process_response function in mod_proxy_http\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758775+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_proxy_http_process_response function in mod_proxy_http.c in the mod_proxy module in the Apache HTTP Server 2.0.63 and 2.2.8 does not limit the number of forwarded interim responses, which allows remote HTTP servers to cause a denial of service (memory consumption) via a large number of interim responses.\"},{\"cve_id\":\"CVE-2008-2168\",\"title\":\"Cross-site scripting (XSS) vulnerability in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758663+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in Apache 2.2.6 and earlier allows remote attackers to inject arbitrary web script or HTML via UTF-7 encoded URLs that are not properly handled when displaying the 403 Forbidden error page.\"},{\"cve_id\":\"CVE-2008-1678\",\"title\":\"Memory leak in the zlib_stateful_init function in crypto/comp/c_zlib\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758588+00:00\",\"source\":\"CVE Database\",\"description\":\"Memory leak in the zlib_stateful_init function in crypto/comp/c_zlib.c in libssl in OpenSSL 0.9.8f through 0.9.8h allows remote attackers to cause a denial of service (memory consumption) via multiple calls, as demonstrated by initial SSL client handshakes to the Apache HTTP Server mod_ssl that specify a compression algorithm.\"},{\"cve_id\":\"CVE-2008-0456\",\"title\":\"CRLF injection vulnerability in the mod_negotiation module in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758496+00:00\",\"source\":\"CVE Database\",\"description\":\"CRLF injection vulnerability in the mod_negotiation module in the Apache HTTP Server 2.2.6 and earlier in the 2.2.x series, 2.0.61 and earlier in the 2.0.x series, and 1.3.39 and earlier in the 1.3.x series allows remote authenticated users to inject arbitrary HTTP headers and conduct HTTP response splitting attacks by uploading a file with a multi-line name containing HTTP header sequences and a file extension, which leads to injection within a (1) \\\"406 Not Acceptable\\\" or (2) \\\"300 Multiple Choices\\\" HTTP response when the extension is omitted in a request for the file.\"},{\"cve_id\":\"CVE-2008-0455\",\"title\":\"Cross-site scripting (XSS) vulnerability in the mod_negotiation module in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758366+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in the mod_negotiation module in the Apache HTTP Server 2.2.6 and earlier in the 2.2.x series, 2.0.61 and earlier in the 2.0.x series, and 1.3.39 and earlier in the 1.3.x series allows remote authenticated users to inject arbitrary web script or HTML by uploading a file with a name containing XSS sequences and a file extension, which leads to injection within a (1) \\\"406 Not Acceptable\\\" or (2) \\\"300 Multiple Choices\\\" HTTP response when the extension is omitted in a request for the file.\"},{\"cve_id\":\"CVE-2008-0005\",\"title\":\"mod_proxy_ftp in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758240+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_proxy_ftp in Apache 2.2.x before 2.2.7-dev, 2.0.x before 2.0.62-dev, and 1.3.x before 1.3.40-dev does not define a charset, which allows remote attackers to conduct cross-site scripting (XSS) attacks using UTF-7 encoding.\"},{\"cve_id\":\"CVE-2007-6750\",\"title\":\"The Apache HTTP Server 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758162+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server 1.x and 2.x allows remote attackers to cause a denial of service (daemon outage) via partial HTTP requests, as demonstrated by Slowloris, related to the lack of the mod_reqtimeout module in versions before 2.2.15.\"},{\"cve_id\":\"CVE-2007-6423\",\"title\":\"Unspecified vulnerability in mod_proxy_balancer for Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.758081+00:00\",\"source\":\"CVE Database\",\"description\":\"Unspecified vulnerability in mod_proxy_balancer for Apache HTTP Server 2.2.x before 2.2.7-dev, when running on Windows, allows remote attackers to trigger memory corruption via a long URL.  NOTE: the vendor could not reproduce this issue\"},{\"cve_id\":\"CVE-2007-6422\",\"title\":\"The balancer_handler function in mod_proxy_balancer in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.757989+00:00\",\"source\":\"CVE Database\",\"description\":\"The balancer_handler function in mod_proxy_balancer in the Apache HTTP Server 2.2.0 through 2.2.6, when a threaded Multi-Processing Module is used, allows remote authenticated users to cause a denial of service (child process crash) via an invalid bb variable.\"},{\"cve_id\":\"CVE-2007-6421\",\"title\":\"Cross-site scripting (XSS) vulnerability in balancer-manager in mod_proxy_balancer in the Apache HTT...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.757884+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in balancer-manager in mod_proxy_balancer in the Apache HTTP Server 2.2.0 through 2.2.6 allows remote attackers to inject arbitrary web script or HTML via the (1) ss, (2) wr, or (3) rr parameters, or (4) the URL.\"},{\"cve_id\":\"CVE-2007-6420\",\"title\":\"Cross-site request forgery (CSRF) vulnerability in the balancer-manager in mod_proxy_balancer for Ap...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.757157+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site request forgery (CSRF) vulnerability in the balancer-manager in mod_proxy_balancer for Apache HTTP Server 2.2.x allows remote attackers to gain privileges via unspecified vectors.\"},{\"cve_id\":\"CVE-2007-6388\",\"title\":\"Cross-site scripting (XSS) vulnerability in mod_status in the Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.757077+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in mod_status in the Apache HTTP Server 2.2.0 through 2.2.6, 2.0.35 through 2.0.61, and 1.3.2 through 1.3.39, when the server-status page is enabled, allows remote attackers to inject arbitrary web script or HTML via unspecified vectors.\"},{\"cve_id\":\"CVE-2007-6203\",\"title\":\"Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756979+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache HTTP Server 2.0.x and 2.2.x does not sanitize the HTTP Method specifier header from an HTTP request when it is reflected back in a \\\"413 Request Entity Too Large\\\" error message, which might allow cross-site scripting (XSS) style attacks using web client components that can send arbitrary headers in requests, as demonstrated via an HTTP request containing an invalid Content-length value, a similar issue to CVE-2006-3918.\"},{\"cve_id\":\"CVE-2007-5000\",\"title\":\"Cross-site scripting (XSS) vulnerability in the (1) mod_imap module in the Apache HTTP Server 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756871+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in the (1) mod_imap module in the Apache HTTP Server 1.3.0 through 1.3.39 and 2.0.35 through 2.0.61 and the (2) mod_imagemap module in the Apache HTTP Server 2.2.0 through 2.2.6 allows remote attackers to inject arbitrary web script or HTML via unspecified vectors.\"},{\"cve_id\":\"CVE-2007-4465\",\"title\":\"Cross-site scripting (XSS) vulnerability in mod_autoindex\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756777+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in mod_autoindex.c in the Apache HTTP Server before 2.2.6, when the charset on a server-generated page is not defined, allows remote attackers to inject arbitrary web script or HTML via the P parameter using the UTF-7 charset.  NOTE: it could be argued that this issue is due to a design limitation of browsers that attempt to perform automatic content type detection.\"},{\"cve_id\":\"CVE-2007-3847\",\"title\":\"The date handling code in modules/proxy/proxy_util\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756673+00:00\",\"source\":\"CVE Database\",\"description\":\"The date handling code in modules/proxy/proxy_util.c (mod_proxy) in Apache 2.3.0, when using a threaded MPM, allows remote origin servers to cause a denial of service (caching forward proxy process crash) via crafted date headers that trigger a buffer over-read.\"},{\"cve_id\":\"CVE-2007-3304\",\"title\":\"Apache httpd 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756592+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache httpd 1.3.37, 2.0.59, and 2.2.4 with the Prefork MPM module, allows local users to cause a denial of service by modifying the worker_score and process_score arrays to reference an arbitrary process ID, which is sent a SIGUSR1 signal from the master process, aka \\\"SIGUSR1 killer.\\\"\"},{\"cve_id\":\"CVE-2007-3303\",\"title\":\"Apache httpd 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756504+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache httpd 2.0.59 and 2.2.4, with the Prefork MPM module, allows local users to cause a denial of service via certain code sequences executed in a worker process that (1) stop request processing by killing all worker processes and preventing creation of replacements or (2) hang the system by forcing the master process to fork an arbitrarily large number of worker processes.  NOTE: This might be an inherent design limitation of Apache with respect to worker processes in hosted environments.\"},{\"cve_id\":\"CVE-2007-1863\",\"title\":\"cache_util\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756384+00:00\",\"source\":\"CVE Database\",\"description\":\"cache_util.c in the mod_cache module in Apache HTTP Server (httpd), when caching is enabled and a threaded Multi-Processing Module (MPM) is used, allows remote attackers to cause a denial of service (child processing handler crash) via a request with the (1) s-maxage, (2) max-age, (3) min-fresh, or (4) max-stale Cache-Control headers without a value.\"},{\"cve_id\":\"CVE-2007-1862\",\"title\":\"The recall_headers function in mod_mem_cache in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756290+00:00\",\"source\":\"CVE Database\",\"description\":\"The recall_headers function in mod_mem_cache in Apache 2.2.4 does not properly copy all levels of header data, which can cause Apache to return HTTP headers containing previously used data, which could be used by remote attackers to obtain potentially sensitive information.\"},{\"cve_id\":\"CVE-2007-1743\",\"title\":\"suexec in Apache HTTP Server (httpd) 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756204+00:00\",\"source\":\"CVE Database\",\"description\":\"suexec in Apache HTTP Server (httpd) 2.2.3 does not verify combinations of user and group IDs on the command line, which might allow local users to leverage other vulnerabilities to create arbitrary UID/GID owned files if /proc is mounted.  NOTE: the researcher, who is reliable, claims that the vendor disputes the issue because \\\"the attacks described rely on an insecure server configuration\\\" in which the user \\\"has write access to the document root.\\\"  In addition, because this is dependent on other vulnerabilities, perhaps this is resultant and should not be included in CVE.\"},{\"cve_id\":\"CVE-2007-1742\",\"title\":\"suexec in Apache HTTP Server (httpd) 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.756071+00:00\",\"source\":\"CVE Database\",\"description\":\"suexec in Apache HTTP Server (httpd) 2.2.3 uses a partial comparison for verifying whether the current directory is within the document root, which might allow local users to perform unauthorized operations on incorrect directories, as demonstrated using \\\"html_backup\\\" and \\\"htmleditor\\\" under an \\\"html\\\" directory.  NOTE: the researcher, who is reliable, claims that the vendor disputes the issue because \\\"the attacks described rely on an insecure server configuration\\\" in which the user \\\"has write access to the document root.\\\"\"},{\"cve_id\":\"CVE-2007-1741\",\"title\":\"Multiple race conditions in suexec in Apache HTTP Server (httpd) 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755940+00:00\",\"source\":\"CVE Database\",\"description\":\"Multiple race conditions in suexec in Apache HTTP Server (httpd) 2.2.3 between directory and file validation, and their usage, allow local users to gain privileges and execute arbitrary code by renaming directories or performing symlink attacks. NOTE: the researcher, who is reliable, claims that the vendor disputes the issue because \\\"the attacks described rely on an insecure server configuration\\\" in which the user \\\"has write access to the document root.\\\"\"},{\"cve_id\":\"CVE-2007-0086\",\"title\":\"The Apache HTTP Server, when accessed through a TCP connection with a large window size, allows remo...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755826+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server, when accessed through a TCP connection with a large window size, allows remote attackers to cause a denial of service (network bandwidth consumption) via a Range header that specifies multiple copies of the same fragment.  NOTE: the severity of this issue has been disputed by third parties, who state that the large window size required by the attack is not normally supported or configured by the server, or that a DDoS-style attack would accomplish the same goal\"},{\"cve_id\":\"CVE-2006-5752\",\"title\":\"Cross-site scripting (XSS) vulnerability in mod_status\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755710+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in mod_status.c in the mod_status module in Apache HTTP Server (httpd), when ExtendedStatus is enabled and a public server-status page is used, allows remote attackers to inject arbitrary web script or HTML via unspecified vectors involving charsets with browsers that perform \\\"charset detection\\\" when the content-type is not specified.\"},{\"cve_id\":\"CVE-2006-4110\",\"title\":\"Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755609+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache 2.2.2, when running on Windows, allows remote attackers to read source code of CGI programs via a request that contains uppercase (or alternate case) characters that bypass the case-sensitive ScriptAlias directive, but allow access to the file on case-insensitive file systems.\"},{\"cve_id\":\"CVE-2006-3918\",\"title\":\"http_protocol\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755520+00:00\",\"source\":\"CVE Database\",\"description\":\"http_protocol.c in (1) IBM HTTP Server 6.0 before 6.0.2.13 and 6.1 before 6.1.0.1, and (2) Apache HTTP Server 1.3 before 1.3.35, 2.0 before 2.0.58, and 2.2 before 2.2.2, does not sanitize the Expect header from an HTTP request when it is reflected back in an error message, which might allow cross-site scripting (XSS) style attacks using web client components that can send arbitrary headers in requests, as demonstrated using a Flash SWF file.\"},{\"cve_id\":\"CVE-2006-3747\",\"title\":\"Off-by-one error in the ldap scheme handling in the Rewrite module (mod_rewrite) in Apache 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755395+00:00\",\"source\":\"CVE Database\",\"description\":\"Off-by-one error in the ldap scheme handling in the Rewrite module (mod_rewrite) in Apache 1.3 from 1.3.28, 2.0.46 and other versions before 2.0.59, and 2.2, when RewriteEngine is enabled, allows remote attackers to cause a denial of service (application crash) and possibly execute arbitrary code via crafted URLs that are not properly handled using certain rewrite rules.\"},{\"cve_id\":\"CVE-2006-20001\",\"title\":\"A carefully crafted If: request header can cause a memory read, or write of a single zero byte, in a...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755240+00:00\",\"source\":\"CVE Database\",\"description\":\"A carefully crafted If: request header can cause a memory read, or write of a single zero byte, in a pool (heap) memory location beyond the header value sent. This could cause the process to crash.  This issue affects Apache HTTP Server 2.4.54 and earlier.\"},{\"cve_id\":\"CVE-2005-3357\",\"title\":\"mod_ssl in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755156+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_ssl in Apache 2.0 up to 2.0.55, when configured with an SSL vhost with access control and a custom error 400 error page, allows remote attackers to cause a denial of service (application crash) via a non-SSL request to an SSL port, which triggers a NULL pointer dereference.\"},{\"cve_id\":\"CVE-2005-3352\",\"title\":\"Cross-site scripting (XSS) vulnerability in the mod_imap module of Apache httpd\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.755065+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in the mod_imap module of Apache httpd before 1.3.35-dev and Apache httpd 2.0.x before 2.0.56-dev allows remote attackers to inject arbitrary web script or HTML via the Referer when using image maps.\"},{\"cve_id\":\"CVE-2005-2970\",\"title\":\"Memory leak in the worker MPM (worker\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754807+00:00\",\"source\":\"CVE Database\",\"description\":\"Memory leak in the worker MPM (worker.c) for Apache 2, in certain circumstances, allows remote attackers to cause a denial of service (memory consumption) via aborted connections, which prevents the memory for the transaction pool from being reused for other connections.\"},{\"cve_id\":\"CVE-2005-2728\",\"title\":\"The byte-range filter in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754718+00:00\",\"source\":\"CVE Database\",\"description\":\"The byte-range filter in Apache 2.0 before 2.0.54 allows remote attackers to cause a denial of service (memory consumption) via an HTTP header with a large Range field.\"},{\"cve_id\":\"CVE-2005-2700\",\"title\":\"ssl_engine_kernel\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754593+00:00\",\"source\":\"CVE Database\",\"description\":\"ssl_engine_kernel.c in mod_ssl before 2.8.24, when using \\\"SSLVerifyClient optional\\\" in the global virtual host configuration, does not properly enforce \\\"SSLVerifyClient require\\\" in a per-location context, which allows remote attackers to bypass intended access restrictions.\"},{\"cve_id\":\"CVE-2005-2088\",\"title\":\"The Apache HTTP server\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754510+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP server before 1.3.34, and 2.0.x before 2.0.55, when acting as an HTTP proxy, allows remote attackers to poison the web cache, bypass web application firewall protection, and conduct XSS attacks via an HTTP request with both a \\\"Transfer-Encoding: chunked\\\" header and a Content-Length header, which causes Apache to incorrectly handle and forward the body of the request in a way that causes the receiving server to process it as a separate HTTP request, aka \\\"HTTP Request Smuggling.\\\"\"},{\"cve_id\":\"CVE-2005-1344\",\"title\":\"Buffer overflow in htdigest in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754391+00:00\",\"source\":\"CVE Database\",\"description\":\"Buffer overflow in htdigest in Apache 2.0.52 may allow attackers to execute arbitrary code via a long realm argument.  NOTE: since htdigest is normally only locally accessible and not setuid or setgid, there are few attack vectors which would lead to an escalation of privileges, unless htdigest is executed from a CGI program.  Therefore this may not be a vulnerability.\"},{\"cve_id\":\"CVE-2005-1268\",\"title\":\"Off-by-one error in the mod_ssl Certificate Revocation List (CRL) verification callback in Apache, w...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754290+00:00\",\"source\":\"CVE Database\",\"description\":\"Off-by-one error in the mod_ssl Certificate Revocation List (CRL) verification callback in Apache, when configured to use a CRL, allows remote attackers to cause a denial of service (child process crash) via a CRL that causes a buffer overflow of one null byte.\"},{\"cve_id\":\"CVE-2004-1834\",\"title\":\"mod_disk_cache in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754205+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_disk_cache in Apache 2.0 through 2.0.49 stores client headers, including authentication information, on the hard disk, which could allow local users to gain sensitive information.\"},{\"cve_id\":\"CVE-2004-0942\",\"title\":\"Apache webserver 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754128+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache webserver 2.0.52 and earlier allows remote attackers to cause a denial of service (CPU consumption) via an HTTP GET request with a MIME header containing multiple lines with a large number of space characters.\"},{\"cve_id\":\"CVE-2004-0885\",\"title\":\"The mod_ssl module in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.754002+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_ssl module in Apache 2.0.35 through 2.0.52, when using the \\\"SSLCipherSuite\\\" directive in directory or location context, allows remote clients to bypass intended restrictions by using any cipher suite that is allowed by the virtual host configuration.\"},{\"cve_id\":\"CVE-2004-0811\",\"title\":\"Unknown vulnerability in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753887+00:00\",\"source\":\"CVE Database\",\"description\":\"Unknown vulnerability in Apache 2.0.51 prevents \\\"the merging of the Satisfy directive,\\\" which could allow attackers to obtain access to restricted resources contrary to the specified authentication configuration.\"},{\"cve_id\":\"CVE-2004-0809\",\"title\":\"The mod_dav module in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753813+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_dav module in Apache 2.0.50 and earlier allows remote attackers to cause a denial of service (child process crash) via a certain sequence of LOCK requests for a location that allows WebDAV authoring access.\"},{\"cve_id\":\"CVE-2004-0786\",\"title\":\"The IPv6 URI parsing routines in the apr-util library for Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753738+00:00\",\"source\":\"CVE Database\",\"description\":\"The IPv6 URI parsing routines in the apr-util library for Apache 2.0.50 and earlier allow remote attackers to cause a denial of service (child process crash) via a certain URI, as demonstrated using the Codenomicon HTTP Test Tool.\"},{\"cve_id\":\"CVE-2004-0751\",\"title\":\"The char_buffer_read function in the mod_ssl module for Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753659+00:00\",\"source\":\"CVE Database\",\"description\":\"The char_buffer_read function in the mod_ssl module for Apache 2.x, when using reverse proxying to an SSL server, allows remote attackers to cause a denial of service (segmentation fault).\"},{\"cve_id\":\"CVE-2004-0748\",\"title\":\"mod_ssl in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753589+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_ssl in Apache 2.0.50 and earlier allows remote attackers to cause a denial of service (CPU consumption) by aborting an SSL connection in a way that causes an Apache child process to enter an infinite loop.\"},{\"cve_id\":\"CVE-2004-0747\",\"title\":\"Buffer overflow in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753511+00:00\",\"source\":\"CVE Database\",\"description\":\"Buffer overflow in Apache 2.0.50 and earlier allows local users to gain apache privileges via a .htaccess file that causes the overflow during expansion of environment variables.\"},{\"cve_id\":\"CVE-2004-0493\",\"title\":\"The ap_get_mime_headers_core function in Apache httpd 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753435+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_get_mime_headers_core function in Apache httpd 2.0.49 allows remote attackers to cause a denial of service (memory exhaustion), and possibly an integer signedness error leading to a heap-based buffer overflow on 64 bit systems, via long header lines with large numbers of space or tab characters.\"},{\"cve_id\":\"CVE-2004-0488\",\"title\":\"Stack-based buffer overflow in the ssl_util_uuencode_binary function in ssl_util\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T09:23:59.753325+00:00\",\"source\":\"CVE Database\",\"description\":\"Stack-based buffer overflow in the ssl_util_uuencode_binary function in ssl_util.c for Apache mod_ssl, when mod_ssl is configured to trust the issuing CA, may allow remote attackers to execute arbitrary code via a client certificate with a long subject DN.\"},{\"cve_id\":\"CVE-2025-9820\",\"title\":\"CVE-2025-9820 affecting package gnutls for versions less than 3\",\"count\":1,\"active_affected_resources\":[\"gnutls\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.855506+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2025-9820 affecting package gnutls for versions less than 3.8.3-8. A patched version of the package is available.\"},{\"cve_id\":\"CVE-2026-1484\",\"title\":\"CVE-2026-1484 affecting package glib for versions less than 2\",\"count\":1,\"active_affected_resources\":[\"glib\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.850897+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-1484 affecting package glib for versions less than 2.78.6-7. A patched version of the package is available.\"},{\"cve_id\":\"CVE-2026-1489\",\"title\":\"CVE-2026-1489 affecting package glib for versions less than 2\",\"count\":1,\"active_affected_resources\":[\"glib\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.850564+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-1489 affecting package glib for versions less than 2.78.6-8. A patched version of the package is available.\"},{\"cve_id\":\"CVE-2026-1642\",\"title\":\"CVE-2026-1642 affecting package nginx for versions less than 1\",\"count\":1,\"active_affected_resources\":[\"nginx\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.849922+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-1642 affecting package nginx for versions less than 1.28.2-1. An upgraded version of the package is available that resolves this issue.\"},{\"cve_id\":\"CVE-2026-3731\",\"title\":\"CVE-2026-3731 affecting package libssh for versions less than 0\",\"count\":1,\"active_affected_resources\":[\"libssh\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.833638+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-3731 affecting package libssh for versions less than 0.10.6-6. A patched version of the package is available.\"},{\"cve_id\":\"CVE-2026-27651\",\"title\":\"CVE-2026-27651 affecting package nginx for versions less than 1\",\"count\":1,\"active_affected_resources\":[\"nginx\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.825987+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-27651 affecting package nginx for versions less than 1.28.3-1. An upgraded version of the package is available that resolves this issue.\"},{\"cve_id\":\"CVE-2026-27654\",\"title\":\"CVE-2026-27654 affecting package nginx for versions less than 1\",\"count\":1,\"active_affected_resources\":[\"nginx\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.825918+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-27654 affecting package nginx for versions less than 1.28.3-1. An upgraded version of the package is available that resolves this issue.\"},{\"cve_id\":\"CVE-2026-27784\",\"title\":\"CVE-2026-27784 affecting package nginx for versions less than 1\",\"count\":1,\"active_affected_resources\":[\"nginx\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.825852+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-27784 affecting package nginx for versions less than 1.28.3-1. An upgraded version of the package is available that resolves this issue.\"},{\"cve_id\":\"CVE-2026-28753\",\"title\":\"CVE-2026-28753 affecting package nginx for versions less than 1\",\"count\":1,\"active_affected_resources\":[\"nginx\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.825785+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-28753 affecting package nginx for versions less than 1.28.3-1. An upgraded version of the package is available that resolves this issue.\"},{\"cve_id\":\"CVE-2026-28755\",\"title\":\"CVE-2026-28755 affecting package nginx for versions less than 1\",\"count\":1,\"active_affected_resources\":[\"nginx\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.825719+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-28755 affecting package nginx for versions less than 1.28.3-1. An upgraded version of the package is available that resolves this issue.\"},{\"cve_id\":\"CVE-2026-32647\",\"title\":\"CVE-2026-32647 affecting package nginx for versions less than 1\",\"count\":1,\"active_affected_resources\":[\"nginx\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:56:32.825651+00:00\",\"source\":\"CVE Database\",\"description\":\"CVE-2026-32647 affecting package nginx for versions less than 1.28.3-1. An upgraded version of the package is available that resolves this issue.\"},{\"cve_id\":\"CVE-2004-0113\",\"title\":\"Memory leak in ssl_engine_io\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.726646+00:00\",\"source\":\"CVE Database\",\"description\":\"Memory leak in ssl_engine_io.c for mod_ssl in Apache 2 before 2.0.49 allows remote attackers to cause a denial of service (memory consumption) via plain HTTP requests to the SSL port of an SSL-enabled server.\"},{\"cve_id\":\"CVE-2003-1581\",\"title\":\"The Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.726573+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server 2.0.44, when DNS resolution is enabled for client IP addresses, allows remote attackers to inject arbitrary text into log files via an HTTP request in conjunction with a crafted DNS response, as demonstrated by injecting XSS sequences, related to an \\\"Inverse Lookup Log Corruption (ILLC)\\\" issue.\"},{\"cve_id\":\"CVE-2003-1580\",\"title\":\"The Apache HTTP Server 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.726472+00:00\",\"source\":\"CVE Database\",\"description\":\"The Apache HTTP Server 2.0.44, when DNS resolution is enabled for client IP addresses, uses a logging format that does not identify whether a dotted quad represents an unresolved IP address, which allows remote attackers to spoof IP addresses via crafted DNS responses containing numerical top-level domains, as demonstrated by a forged 123.123.123.123 domain name, related to an \\\"Inverse Lookup Log Corruption (ILLC)\\\" issue.\"},{\"cve_id\":\"CVE-2003-1307\",\"title\":\"The mod_php module for the Apache HTTP Server allows local users with write access to PHP scripts to...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.726330+00:00\",\"source\":\"CVE Database\",\"description\":\"The mod_php module for the Apache HTTP Server allows local users with write access to PHP scripts to send signals to the server's process group and use the server's file descriptors, as demonstrated by sending a STOP signal, then intercepting incoming connections on the server's TCP port.  NOTE: the PHP developer has disputed this vulnerability, saying \\\"The opened file descriptors are opened by Apache. It is the job of Apache to protect them ... Not a bug in PHP.\"},{\"cve_id\":\"CVE-2003-1138\",\"title\":\"The default configuration of Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.726167+00:00\",\"source\":\"CVE Database\",\"description\":\"The default configuration of Apache 2.0.40, as shipped with Red Hat Linux 9.0, allows remote attackers to list directory contents, even if auto indexing is turned off and there is a default web page configured, via a GET request containing a double slash (//).\"},{\"cve_id\":\"CVE-2003-0789\",\"title\":\"mod_cgid in Apache\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.726091+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_cgid in Apache before 2.0.48, when using a threaded MPM, does not properly handle CGI redirect paths, which could cause Apache to send the output of a CGI program to the wrong client.\"},{\"cve_id\":\"CVE-2003-0542\",\"title\":\"Multiple stack-based buffer overflows in (1) mod_alias and (2) mod_rewrite for Apache\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.726025+00:00\",\"source\":\"CVE Database\",\"description\":\"Multiple stack-based buffer overflows in (1) mod_alias and (2) mod_rewrite for Apache before 1.3.29 allow attackers to create configuration files to cause a denial of service (crash) or execute arbitrary code via a regular expression with more than 9 captures.\"},{\"cve_id\":\"CVE-2003-0254\",\"title\":\"Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725939+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache 2 before 2.0.47, when running on an IPv6 host, allows attackers to cause a denial of service (CPU consumption by infinite loop) when the FTP proxy server fails to create an IPv6 socket.\"},{\"cve_id\":\"CVE-2003-0253\",\"title\":\"The prefork MPM in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725873+00:00\",\"source\":\"CVE Database\",\"description\":\"The prefork MPM in Apache 2 before 2.0.47 does not properly handle certain errors from accept, which could lead to a denial of service.\"},{\"cve_id\":\"CVE-2003-0245\",\"title\":\"Vulnerability in the apr_psprintf function in the Apache Portable Runtime (APR) library for Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725817+00:00\",\"source\":\"CVE Database\",\"description\":\"Vulnerability in the apr_psprintf function in the Apache Portable Runtime (APR) library for Apache 2.0.37 through 2.0.45 allows remote attackers to cause a denial of service (crash) and possibly execute arbitrary code via long strings, as demonstrated using XML objects to mod_dav, and possibly other vectors.\"},{\"cve_id\":\"CVE-2003-0192\",\"title\":\"Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725729+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache 2 before 2.0.47, and certain versions of mod_ssl for Apache 1.3, do not properly handle \\\"certain sequences of per-directory renegotiations and the SSLCipherSuite directive being used to upgrade from a weak ciphersuite to a strong one,\\\" which could cause Apache to use the weak ciphersuite.\"},{\"cve_id\":\"CVE-2003-0189\",\"title\":\"The authentication module for Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725614+00:00\",\"source\":\"CVE Database\",\"description\":\"The authentication module for Apache 2.0.40 through 2.0.45 on Unix does not properly handle threads safely when using the crypt_r or crypt functions, which allows remote attackers to cause a denial of service (failed Basic authentication with valid usernames and passwords) when a threaded MPM is used.\"},{\"cve_id\":\"CVE-2003-0134\",\"title\":\"Unknown vulnerability in filestat\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725529+00:00\",\"source\":\"CVE Database\",\"description\":\"Unknown vulnerability in filestat.c for Apache running on OS2, versions 2.0 through 2.0.45, allows unknown attackers to cause a denial of service via requests related to device names.\"},{\"cve_id\":\"CVE-2003-0132\",\"title\":\"A memory leak in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725462+00:00\",\"source\":\"CVE Database\",\"description\":\"A memory leak in Apache 2.0 through 2.0.44 allows remote attackers to cause a denial of service (memory consumption) via large chunks of linefeed characters, which causes Apache to allocate 80 bytes for each linefeed.\"},{\"cve_id\":\"CVE-2003-0083\",\"title\":\"Apache 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725366+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache 1.3 before 1.3.25 and Apache 2.0 before version 2.0.46 does not filter terminal escape sequences from its access logs, which could make it easier for attackers to insert those sequences into terminal emulators containing vulnerabilities related to escape sequences, a different vulnerability than CVE-2003-0020.\"},{\"cve_id\":\"CVE-2003-0020\",\"title\":\"Apache does not filter terminal escape sequences from its error logs, which could make it easier for...\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725224+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache does not filter terminal escape sequences from its error logs, which could make it easier for attackers to insert those sequences into terminal emulators containing vulnerabilities related to escape sequences.\"},{\"cve_id\":\"CVE-2002-1850\",\"title\":\"mod_cgi in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725155+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_cgi in Apache 2.0.39 and 2.0.40 allows local users and possibly remote attackers to cause a denial of service (hang and memory consumption) by causing a CGI script to send a large amount of data to stderr, which results in a read/write deadlock between httpd and the CGI script.\"},{\"cve_id\":\"CVE-2002-1593\",\"title\":\"mod_dav in Apache\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725074+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_dav in Apache before 2.0.42 does not properly handle versioning hooks, which may allow remote attackers to kill a child process via a null dereference and cause a denial of service (CPU consumption) in a preforked multi-processing module.\"},{\"cve_id\":\"CVE-2002-1592\",\"title\":\"The ap_log_rerror function in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.725000+00:00\",\"source\":\"CVE Database\",\"description\":\"The ap_log_rerror function in Apache 2.0 through 2.035, when a CGI application encounters an error, sends error messages to the client that include the full path for the server, which allows remote attackers to obtain sensitive information.\"},{\"cve_id\":\"CVE-2002-1156\",\"title\":\"Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.724922+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache 2.0.42 allows remote attackers to view the source code of a CGI script via a POST request to a directory with both WebDAV and CGI enabled.\"},{\"cve_id\":\"CVE-2002-0840\",\"title\":\"Cross-site scripting (XSS) vulnerability in the default error page of Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.724864+00:00\",\"source\":\"CVE Database\",\"description\":\"Cross-site scripting (XSS) vulnerability in the default error page of Apache 2.0 before 2.0.43, and 1.3.x up to 1.3.26, when UseCanonicalName is \\\"Off\\\" and support for wildcard DNS is present, allows remote attackers to execute script as other web page visitors via the Host: header, a different vulnerability than CAN-2002-1157.\"},{\"cve_id\":\"CVE-2002-0661\",\"title\":\"Directory traversal vulnerability in Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.724775+00:00\",\"source\":\"CVE Database\",\"description\":\"Directory traversal vulnerability in Apache 2.0 through 2.0.39 on Windows, OS2, and Netware allows remote attackers to read arbitrary files and execute commands via .. (dot dot) sequences containing \\\\ (backslash) characters.\"},{\"cve_id\":\"CVE-2002-0654\",\"title\":\"Apache 2\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.724700+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache 2.0 through 2.0.39 on Windows, OS2, and Netware allows remote attackers to determine the full pathname of the server via (1) a request for a .var file, which leaks the pathname in the resulting error message, or (2) via an error message that occurs when a script (child process) cannot be invoked.\"},{\"cve_id\":\"CVE-2002-0392\",\"title\":\"Apache 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.724616+00:00\",\"source\":\"CVE Database\",\"description\":\"Apache 1.3 through 1.3.24, and Apache 2.0 through 2.0.36, allows remote attackers to cause a denial of service and possibly execute arbitrary code via a chunk-encoded HTTP request that causes Apache to use an incorrect size.\"},{\"cve_id\":\"CVE-2001-1534\",\"title\":\"mod_usertrack in Apache 1\",\"count\":1,\"active_affected_resources\":[\"apache2\"],\"match_type\":\"potential\",\"date\":\"2026-04-20T07:55:15.724542+00:00\",\"source\":\"CVE Database\",\"description\":\"mod_usertrack in Apache 1.3.11 through 1.3.20 generates session ID's using predictable information including host IP address, system time and server process ID, which allows local users to obtain session ID's and bypass authentication when these session ID's are used for authentication.\"},{\"cve_id\":\"CVE-2025-14831 GNUTLS-SA-2026-02-09-2\",\"title\":\"Security fix for gnutls in Alpine Linux edge\",\"count\":1,\"active_affected_resources\":[\"gnutls\"],\"match_type\":\"potential\",\"date\":\"2026-04-18T17:32:42.563474+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for gnutls in Alpine Linux edge\"},{\"cve_id\":\"CVE-2026-1584 GNUTLS-SA-2026-02-09-1\",\"title\":\"Security fix for gnutls in Alpine Linux edge\",\"count\":1,\"active_affected_resources\":[\"gnutls\"],\"match_type\":\"potential\",\"date\":\"2026-04-18T17:32:42.563445+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for gnutls in Alpine Linux edge\"},{\"cve_id\":\"CVE-2024-12243 GNUTLS-SA-2025-02-07\",\"title\":\"Security fix for gnutls in Alpine Linux edge\",\"count\":1,\"active_affected_resources\":[\"gnutls\"],\"match_type\":\"potential\",\"date\":\"2026-04-18T17:32:42.563416+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for gnutls in Alpine Linux edge\"},{\"cve_id\":\"CVE-2025-6395 GNUTLS-SA-2025-07-08-4\",\"title\":\"Security fix for gnutls in Alpine Linux edge\",\"count\":1,\"active_affected_resources\":[\"gnutls\"],\"match_type\":\"potential\",\"date\":\"2026-04-18T17:32:42.563387+00:00\",\"source\":\"CVE Database\",\"description\":\"Security fix for gnutls in Alpine Linux edge\"},{\"cve_id\":\"CVE-2025-3299