            "text": ".dashboard_component{--card-bg: var(--background-primary);--card-border: var(--border-color);--text-primary: var(--text-primary);--text-secondary: var(--text-secondary);--hover-shadow: rgba(0, 0, 0, .2)}.dashboard_component .card{width:360px;flex-shrink:0;border-radius:5px;padding:15px;display:flex;justify-content:space-between;cursor:pointer}[data-theme=dark] .dashboard_component .card{background:none}.dashboard_component .icon{width:50px;height:50px;flex-shrink:0;border-radius:50%;display:flex;justify-content:center;align-items:center;margin-bottom:24px}.dashboard_component .service_type{color:var(--text-primary);font-family:Manrope;font-size:16px;font-style:normal;font-weight:600;line-height:1}.dashboard_component .total_count{color:var(--text-primary);font-family:Manrope;font-size:28px;font-style:normal;font-weight:700;line-height:1}.dashboard_component .squre_icon{width:10px;height:10px;border-radius:2px;display:inline-block;margin-right:6px}.dashboard_component .cloud_provider{color:var(--text-secondary);font-family:Manrope;font-size:12px;font-style:normal;font-weight:500;line-height:150%}.dashboard_component .card_recommenadation{flex-basis:calc(33.33% - 10px);height:104px;flex-shrink:0;border-radius:5px;background:var(--card-bg);border:1px solid var(--card-border);padding:15px;margin-top:15px;display:flex;align-items:center;gap:10px}[data-theme=dark] .dashboard_component .card_recommenadation{background:var(--background-secondary)}.dashboard_component .identity_top_cards:hover{cursor:pointer}[data-theme=dark] .dashboard_component .identity_top_cards:hover{box-shadow:0 1px 3px #ffffff1a}.dashboard_component .recommendation_details{color:var(--text-secondary);font-family:Manrope;font-size:13px;font-style:normal;font-weight:500;line-height:normal;letter-spacing:.14px}.dashboard_component .resource_count{color:var(--text-primary);text-align:center;font-family:Manrope;font-size:18px;font-style:normal;font-weight:600;line-height:normal}.dashbo