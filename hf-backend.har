            "text": ".dashboard_charts .circle-container{display:flex;align-items:center;justify-content:center;padding:5px 0 25px}.dashboard_charts .circle-outer{width:155px;height:155px;border-radius:50%;background-color:#f84d4d;position:relative;stroke-linecap:round}.dashboard_charts .circle-inner{width:130px;height:130px;border-radius:50%;background-color:#fff;display:flex;align-items:center;justify-content:center;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);stroke-linecap:round}.dashboard_charts .circle-text{color:var(--secondary-400, #484d56);text-align:center;font-family:Manrope;font-size:28px;font-style:normal;font-weight:800;line-height:normal}.dashboard_charts .y-axis-tick,.dashboard_charts .recharts-cartesian-axis-line,.dashboard_charts .recharts-cartesian-axis-tick-line{display:none}#line_chart_dashboard_new{width:100%;min-width:0px;margin-left:-13%;display:flex;flex-grow:1}#line_chart_dashboard_new .recharts-cartesian-axis-line,#line_chart_dashboard_new .recharts-cartesian-axis-tick-line{display:none}#line_chart_dashboard_new .recharts-cartesian-grid{padding-left:10px}#line_chart_dashboard_new .recharts-cartesian-axis{margin-left:15px}#line_chart_dashboard_new .recharts-cartesian-axis-tick-value{color:var(--greyscale-600, #718096);text-align:center;font-family:Manrope;font-size:12px;font-style:normal;font-weight:500;line-height:normal}#line_chart_dashboard_new .recharts-legend-item-text{color:var(--secondary-400, #484d56);font-family:Manrope;font-size:12px;font-style:normal;font-weight:500;line-height:150%}#line_chart_dashboard_new .custom-legend-resource-trend{justify-content:center;align-items:center;padding:10px}#line_chart_dashboard_new .legend-text{color:var(--secondary-400, #484d56);font-family:Manrope;font-size:12px;font-style:normal;font-weight:500;line-height:150%}.resource_trend_chart .y-axis-tick,.resource_trend_chart .recharts-cartesian-axis-line,.resource_trend_chart .recharts-cartesian-axis-tick-line{display:none}.resource_trend_chart .recharts-cartesian-axis-tick-value{color:var(--greyscale-600, #71717a);text-align:center;font-family:Manrope;font-size:12px;font-style:normal;font-weight:400;line-height:normal}.resource_trend_chart .recharts-legend-item-text{color:var(--secondary-400, #484d56);font-family:Manrope;font-size:12px;font-style:normal;font-weight:500;line-height:150%}.resource_trend_chart .custom-legend-resource-trend{justify-content:center;align-items:center;padding:10px}.resource_trend_chart .legend-text{color:var(--secondary-400, #484d56)!important;font-family:Manrope;font-size:12px;font-style:normal;font-weight:500;line-height:150%}.resource_trend_chart .legend-policy-text{font-family:Manrope;font-size:12px;font-weight:400;line-height:16px;color:#09090b;text-align:left}.custom_tooltip{display:inline-flex;padding:10px;flex-direction:column;justify-content:center;align-items:flex-start;width:max-content;gap:9px;border-radius:4px;border:1px solid var(--boder-line-light, #cbd5e0);background:var(--others-white, #fff);box-shadow:5.3333334923px 5.3333334923px 21.3333339691px #1a202c14;outline:0}.custom_tooltip_severity{color:var(--secondary-base, #1a202c);font-family:Manrope;font-size:12px;font-style:normal;font-weight:500}.custom_tooltip_count{color:var(--secondary-base, #1a202c);font-family:Manrope;font-size:12px;font-style:normal;font-weight:700}\n"
