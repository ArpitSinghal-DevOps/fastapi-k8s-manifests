            "mimeType": "text/css",
            "text": "html{--dashboard-bg-primary: #fff;--dashboard-bg-secondary: #f7fafc;--dashboard-text-primary: #1a202c;--dashboard-text-secondary: #484d56;--dashboard-border-color: #cbd5e0;--dashboard-card-bg: #fff;--dashboard-shadow: rgba(93, 106, 131, .05);--dashboard-tooltip-bg: #fff;--dashboard-tooltip-border: #cbd5e0;--dashboard-live-bg: #fff;--dashboard-progress-bg: #edf2f7}html[data-theme=dark]{--dashboard-bg-primary: #1a202c;--dashboard-bg-secondary: #2d3748;--dashboard-text-primary: #e2e8f0;--dashboard-text-secondary: #a0aec0;--dashboard-border-color: #484d56;--dashboard-card-bg: #2d3748;--dashboard-shadow: rgba(0, 0, 0, .2);--dashboard-tooltip-bg: #2d3748;--dashboard-tooltip-border: #484d56;--dashboard-live-bg: #2d3748;--dashboard-progress-bg: #1a202c}.dashboard{background-color:var(--dashboard-bg-primary);color:var(--dashboard-text-primary);transition:all .2s ease}.dashboard__container{background-color:var(--dashboard-bg-secondary)}.dashboard__card{background-color:var(--dashboard-card-bg);border:1px solid var(--dashboard-border-color)}.dashboard__card:hover{box-shadow:0 4px 6px var(--dashboard-shadow)}.dashboard__heading{color:var(--dashboard-text-primary)}.dashboard__subheading{color:var(--dashboard-text-secondary)}.dashboard .security_container_title{color:var(--dashboard-text-primary);text-align:right;font-family:Manrope;font-size:13px;font-style:normal;font-weight:600;line-height:normal;color:\"#1a202c\"}.dashboard .no_overflow{overflow:hidden}.dashboard .security_enviroment_id{color:var(--dashboard-text-primary);font-family:Manrope;font-size:13px;font-style:normal;font-weight:500;line-height:normal}.dashboard .security_value{color:var(--dashboard-text-primary);font-family:Manrope;font-size:13px;font-style:normal;font-weight:600;line-height:normal;width:40px;text-align:left}.dashboard .risk_trend_value{color:var(--dashboard-text-primary);font-family:Manrope;font-size:13px;font-style:normal;font-weight:600;line-height:normal}.dashboard .risk_trend_percentage{font-family:Manrope;font-size:13px;font-style:normal;font-weight:600;line-height:normal;padding-right:4px}.dashboard .compliance_card{border-radius:5px;background:var(--dashboard-card-bg);border:1px solid var(--dashboard-border-color);height:42px;display:flex;align-items:center;padding:5px 15px 0}.dashboard .ComplianceScoreCard__Container_dashboard{height:50px;align-items:center;border-bottom:1px solid #e2e8f0;display:flex;cursor:pointer}.dashboard .ComplianceScoreCard__Container_dashboard>img{width:30px}.dashboard .ComplianceScoreCard__Container_dashboard .IAMComplianceScoreCard__InnerContainer{align-items:center;margin-bottom:9px;width:calc(100% - 53px);margin-left:15px}.dashboard .ComplianceScoreCard__Container_dashboard .icsc__topContent{display:flex}.dashboard .ComplianceScoreCard__Container_dashboard .icsc__topContent .icsc__title{color:var(--dashboard-text-primary);font-family:Manrope;font-size:12px;font-weight:500;margin-bottom:6px;text-overflow:ellipsis;overflow:hidden;white-space:nowrap;flex-grow:1;margin-right:10px}.dashboard .ComplianceScoreCard__Container_dashboard .icsc__topContent .icsc__total{color:var(--dashboard-text-secondary);font-family:Manrope;font-size:12px;font-weight:500;line-height:14px;margin-right:4px}.dashboard .ComplianceScoreCard__Container_dashboard .icsc__topContent .iscs__totalValue{color:var(--dashboard-text-primary);font-family:Manrope;font-size:13px;font-weight:500;line-height:14px;width:50px;display:flex;flex-direction:row;text-align:right;justify-content:end}.dashboard .ComplianceScoreCard__Container_dashboard .compliance_card_percentage{color:var(--alerts-error-base, #f62121);text-align:right;font-family:Manrope;font-size:12px;font-style:normal;font-weight:700;line-height:14px}.dashboard .ComplianceScoreCard__Container_dashboard .progress--main--provider{height:20px}.dashboard .compliance_card_heading{color:var(--dashboard-text-primary);padding-bottom:10px;font-family:Manrope;font-size:14px;font-style:normal;font-weight:800;line-height:normal}.dashboard .threat_value{color:var(--dashboard-text-primary);font-family:Manrope;font-size:13px;font-style:normal;font-weight:600;line-height:normal;width:30px;text-align:left}.dashboard .threat_title{color:var(--dashboard-text-primary);font-family:Manrope;font-size:13px;font-style:normal;font-weight:500;line-height:normal;display:flex;align-items:center}.dashboard .live_icon{border-radius:11px;background:var(--dashboard-live-bg);box-shadow:0 8px 18px 0 var(--dashboard-shadow);display:flex;padding:2px 10px;align-items:center;gap:4px}.dashboard .live_text{color:var(--dashboard-text-primary);font-family:Manrope;font-size:12px;font-style:normal;font-weight:600;line-height:normal}.dashboard .ProgressBar{height:10px;border:none!important;border-radius:10px;background-color:var(--dashboard-progress-bg)}.dashboard .custom_tooltip{display:inline-flex;padding:10px;flex-direction:column;justify-content:center;align-items:flex-start;width:max-content;gap:9px;border-radius:4px;border:1px solid var(--dashboard-tooltip-border);background:var(--dashboard-tooltip-bg);box-shadow:5.33px 5.33px 21.33px var(--dashboard-shadow);outline:0}.dashboard .custom_tooltip_severity{color:var(--dashboard-text-primary);font-family:Manrope;font-size:12px;font-style:normal;font-weight:500}.dashboard .custom_tooltip_count{color:var(--dashboard-text-primary);font-family:Manrope;font-size:12px;font-style:normal;font-weight:700}.dashboard .count_container{display:flex;flex-direction:column;gap:5px}@media (min-width: 1720px){.dashboard .security_score{width:7.8vw}}.dashboard .recharts-cartesian-axis-line,.dashboard .recharts-cartesian-grid-vertical,.dashboard .recharts-cartesian-axis-tick-line{display:none}.dashboard .recharts-cartesian-axis-tick-value{font-family:Manrope;fill:var(--dashboard-text-secondary)}.dashboard-stats__card{background-color:var(--dashboard-card-bg);border:1px solid var(--dashboard-border-color)}.dashboard-stats__value{color:var(--dashboard-text-primary)}.dashboard-stats__label{color:var(--dashboard-text-secondary)}\n"
