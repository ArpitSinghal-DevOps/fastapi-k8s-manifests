w:1;flex-shrink:0;align-items:center;justify-content:center}.dashboard_component .CloudProviderBar .CloudProviderBar__Option_CE:hover,.dashboard_component .CloudProviderBar .CloudProviderBar__Option_CE.Active{border-bottom-color:#194bfb}.dashboard_component .CloudProviderBar .CloudProviderBar__Option_CE img{width:16px;margin-right:8px}.dashboard_component .CloudProviderBar .bar_text{color:var(--text-secondary);font-family:Manrope;font-size:12px;font-style:normal;font-weight:500;line-height:normal}.dashboard_component .priority-funel-text{color:var(--text-secondary);font-family:Manrope;font-size:14px;font-style:normal;font-weight:500;line-height:normal}.dashboard_component .card-bg-image{background-image:url(/assets/Wave-16cce4f3.svg);background-repeat:no-repeat;background-size:cover;background-color:transparent!important;box-shadow:none}.dashboard_component .image-container{position:relative;width:100%;height:0;padding-bottom:30%;padding-top:15px;overflow:hidden}.dashboard_component .cover-image{position:absolute;top:0;left:0;width:100%;height:100%}.dashboard_component .sankeychart-main-wrapper{display:flex;min-height:400px;flex:1;position:relative}.dashboard_component .sankeychart-main-wrapper .sankeychart-1{width:100%;height:inherit}.dashboard_component .sankeychart-main-wrapper .attacking-path-wrapper{position:absolute;width:12.5%;min-width:200px;height:100%;margin:auto;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(180deg,#fc00ff 0%,#00dbde 100%)}.dashboard_component .sankeychart-main-wrapper .attacking-path-wrapper.attacked-path-list{padding-top:50px;padding-left:12px;padding-right:12px;align-items:flex-start}.dashboard_component .sankeychart-main-wrapper .attacking-path-wrapper ul.attackingPath-list-wrapper{padding:0;margin:0;list-style-type:none}.dashboard_component .sankeychart-main-wrapper .attacking-path-wrapper ul.attackingPath-list-wrapper li{color:#fff;text-align:center;font-family:Manrope